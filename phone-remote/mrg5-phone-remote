#!/bin/sh
# mrg5-phone-remote (checks/41, "Phone remote"): a phone's browser as touchpad and keyboard for the
# TV. remote-touchpad (unrud/remote-touchpad 1.5.5, GPL-3.0; X11 backend, XTest into the TV's
# display :0) serves its page on port 8090. The secret that authorises a phone is made once per
# boot in /run (RAM) and read by the launcher, which shows the page's address as a QR code in its
# settings; restarts within a boot (X not up yet, X restarted) keep the same secret.
D=/run/mrg5-phone-remote
umask 077
mkdir -p "$D"
# 12 random bytes, URL-safe base64 (16 characters), as long as remote-touchpad's own
[ -s "$D/secret" ] || head -c 12 /dev/urandom | base64 | tr '+/' '-_' > "$D/secret"
exec /usr/local/bin/remote-touchpad -bind :8090 -secret "$(cat "$D/secret")"
