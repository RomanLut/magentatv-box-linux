+static void __init mrg5_audio_watch_dump(void __iomem *base, const char *when)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_audio_watch); i++) {
+		u32 a = mrg5_audio_watch[i];
+
