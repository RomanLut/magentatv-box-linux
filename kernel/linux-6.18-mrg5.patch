+static int mrg5_vol_info(struct snd_kcontrol *kc, struct snd_ctl_elem_info *ui)
+{
+	ui->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	ui->count = 1;
+	ui->value.integer.min = 0;
+	ui->value.integer.max = MRG5_VOL_MAX;
+	return 0;
+}
+
+static int mrg5_vol_get(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uv)
+{
+	struct mrg5_hdmi *m = snd_kcontrol_chip(kc);
+
+	uv->value.integer.value[0] = m->volume;
+	return 0;
+}
+
+static int mrg5_vol_put(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uv)
+{
+	struct mrg5_hdmi *m = snd_kcontrol_chip(kc);
+	unsigned long flags;
+	unsigned int v = uv->value.integer.value[0];
+
+	if (v > MRG5_VOL_MAX)
+		v = MRG5_VOL_MAX;
+	if (v == m->volume)
+		return 0;
+
+	spin_lock_irqsave(&m->lock, flags);
+	m->volume = v;
+	mrg5_apply_volume(m);
+	spin_unlock_irqrestore(&m->lock, flags);
+	return 1;
+}
+
+static int mrg5_sw_get(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uv)
+{
+	struct mrg5_hdmi *m = snd_kcontrol_chip(kc);
+
+	uv->value.integer.value[0] = !m->muted;
+	return 0;
+}
+
+static int mrg5_sw_put(struct snd_kcontrol *kc, struct snd_ctl_elem_value *uv)
+{
+	struct mrg5_hdmi *m = snd_kcontrol_chip(kc);
+	unsigned long flags;
+	bool mute = !uv->value.integer.value[0];
+
+	if (mute == m->muted)
+		return 0;
+
+	spin_lock_irqsave(&m->lock, flags);
+	m->muted = mute;
+	if (m->unmuted)
+		mrg5_mai_mute(m, mute);
+	spin_unlock_irqrestore(&m->lock, flags);
+	return 1;
+}
