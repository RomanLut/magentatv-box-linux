diff -ruN a/drivers/gpu/drm/mrg5/mrg5_drm.c b/drivers/gpu/drm/mrg5/mrg5_drm.c
--- a/drivers/gpu/drm/mrg5/mrg5_drm.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/gpu/drm/mrg5/mrg5_drm.c	2026-10-03 00:12:23.436812972 +0200
@@ -0,0 +1,414 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/dma-buf.h>
+#include <linux/dma-direct.h>
+#include <linux/dma-mapping.h>
+#include <linux/dma-resv.h>
+#include <linux/hrtimer.h>
+#include <linux/ktime.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/mrg5-display.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_atomic_helper.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_prime.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+
+#define MRG5_W		1920
+#define MRG5_H		1080
+#define MRG5_PITCH	(MRG5_W * 4)
+
+struct mrg5_drm {
+	struct drm_device drm;
+	struct drm_connector connector;
+	struct drm_simple_display_pipe pipe;
+	struct hrtimer vblank_timer;
+	ktime_t period;
+};
+
+static struct mrg5_drm *to_mrg5(struct drm_device *drm)
+{
+	return container_of(drm, struct mrg5_drm, drm);
+}
+
+static const struct drm_display_mode mrg5_mode = {
+	DRM_MODE("1920x1080", DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+		 148500, 1920, 2448, 2492, 2640, 0, 1080, 1084, 1089, 1125, 0,
+		 DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC)
+};
+
+static const u32 mrg5_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+};
+
+static const u64 mrg5_modifiers[] = {
+	DRM_FORMAT_MOD_LINEAR,
+	DRM_FORMAT_MOD_INVALID,
+};
+
+
+static int mrg5_connector_get_modes(struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &mrg5_mode);
+}
+
+static const struct drm_connector_helper_funcs mrg5_connector_helper_funcs = {
+	.get_modes = mrg5_connector_get_modes,
+};
+
+static const struct drm_connector_funcs mrg5_connector_funcs = {
+	.reset = drm_atomic_helper_connector_reset,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+
+static enum hrtimer_restart mrg5_vblank_timer_fn(struct hrtimer *t)
+{
+	struct mrg5_drm *m = container_of(t, struct mrg5_drm, vblank_timer);
+
+	drm_crtc_handle_vblank(&m->pipe.crtc);
+	hrtimer_forward_now(t, m->period);
+	return HRTIMER_RESTART;
+}
+
+static int mrg5_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct mrg5_drm *m = to_mrg5(pipe->crtc.dev);
+
+	hrtimer_start(&m->vblank_timer, m->period, HRTIMER_MODE_REL);
+	return 0;
+}
+
+static void mrg5_disable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct mrg5_drm *m = to_mrg5(pipe->crtc.dev);
+
+	hrtimer_cancel(&m->vblank_timer);
+}
+
+
+static enum drm_mode_status
+mrg5_mode_valid(struct drm_simple_display_pipe *pipe,
+		const struct drm_display_mode *mode)
+{
+	if (mode->hdisplay != MRG5_W || mode->vdisplay != MRG5_H ||
+	    drm_mode_vrefresh(mode) != 50)
+		return MODE_BAD;
+	return MODE_OK;
+}
+
+static int mrg5_check(struct drm_simple_display_pipe *pipe,
+		      struct drm_plane_state *plane_state,
+		      struct drm_crtc_state *crtc_state)
+{
+	struct drm_framebuffer *fb = plane_state->fb;
+
+	if (!plane_state->visible || !fb)
+		return 0;
+
+	if (fb->width != MRG5_W || fb->height != MRG5_H ||
+	    fb->pitches[0] != MRG5_PITCH || fb->offsets[0] != 0 ||
+	    plane_state->crtc_x || plane_state->crtc_y ||
+	    (plane_state->src_x >> 16) || (plane_state->src_y >> 16))
+		return -EINVAL;
+
+	if (!mrg5_p50_ready())
+		return -EBUSY;
+	return 0;
+}
+
+static void mrg5_scanout(struct drm_simple_display_pipe *pipe,
+			 struct drm_plane_state *state)
+{
+	struct drm_framebuffer *fb = state->fb;
+
+	if (fb)
+		mrg5_p50_set_scanout((u32)drm_fb_dma_get_gem_addr(fb, state, 0));
+}
+
+static void mrg5_send_event(struct drm_simple_display_pipe *pipe)
+{
+	struct drm_crtc *crtc = &pipe->crtc;
+	struct drm_pending_vblank_event *event = crtc->state->event;
+
+	if (!event)
+		return;
+	crtc->state->event = NULL;
+
+	spin_lock_irq(&crtc->dev->event_lock);
+	if (drm_crtc_vblank_get(crtc) == 0)
+		drm_crtc_arm_vblank_event(crtc, event);
+	else
+		drm_crtc_send_vblank_event(crtc, event);
+	spin_unlock_irq(&crtc->dev->event_lock);
+}
+
+static void mrg5_enable(struct drm_simple_display_pipe *pipe,
+			struct drm_crtc_state *crtc_state,
+			struct drm_plane_state *plane_state)
+{
+	mrg5_scanout(pipe, plane_state);
+	drm_crtc_vblank_on(&pipe->crtc);
+}
+
+static void mrg5_disable(struct drm_simple_display_pipe *pipe)
+{
+	drm_crtc_vblank_off(&pipe->crtc);
+	mrg5_p50_set_scanout(mrg5_p50_console_scanout());
+}
+
+static void mrg5_update(struct drm_simple_display_pipe *pipe,
+			struct drm_plane_state *old_state)
+{
+	struct drm_plane_state *state = pipe->plane.state;
+
+	if (state->fb && state->fb != old_state->fb)
+		mrg5_scanout(pipe, state);
+	mrg5_send_event(pipe);
+}
+
+static const struct drm_simple_display_pipe_funcs mrg5_pipe_funcs = {
+	.mode_valid = mrg5_mode_valid,
+	.check = mrg5_check,
+	.enable = mrg5_enable,
+	.disable = mrg5_disable,
+	.update = mrg5_update,
+	.enable_vblank = mrg5_enable_vblank,
+	.disable_vblank = mrg5_disable_vblank,
+};
+
+static const struct drm_mode_config_funcs mrg5_mode_config_funcs = {
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+static const struct dma_buf_ops mrg5_dmabuf_ops;
+
+static int mrg5_dmabuf_mmap(struct dma_buf *dmabuf, struct vm_area_struct *vma)
+{
+	struct drm_gem_object *obj = dmabuf->priv;
+	struct drm_gem_dma_object *dma = to_drm_gem_dma_obj(obj);
+	unsigned long pfn;
+
+	if (vma->vm_flags & VM_WRITE)
+		return drm_gem_dmabuf_mmap(dmabuf, vma);
+
+	pfn = PHYS_PFN(dma_to_phys(obj->dev->dev, dma->dma_addr)) + vma->vm_pgoff;
+	vm_flags_mod(vma, VM_DONTEXPAND | VM_DONTDUMP, VM_MAYWRITE);
+	vma->vm_page_prot = vm_get_page_prot(vma->vm_flags);
+	return remap_pfn_range(vma, vma->vm_start, pfn,
+			       vma->vm_end - vma->vm_start, vma->vm_page_prot);
+}
+
+static int mrg5_dmabuf_begin_cpu_access(struct dma_buf *dmabuf,
+					enum dma_data_direction dir)
+{
+	struct drm_gem_object *obj = dmabuf->priv;
+	struct drm_gem_dma_object *dma = to_drm_gem_dma_obj(obj);
+	bool write = dir == DMA_BIDIRECTIONAL || dir == DMA_TO_DEVICE;
+	long ret;
+
+	ret = dma_resv_wait_timeout(dmabuf->resv, dma_resv_usage_rw(write),
+				    true, MAX_SCHEDULE_TIMEOUT);
+	if (ret < 0)
+		return ret;
+	dma_sync_single_for_cpu(obj->dev->dev, dma->dma_addr, obj->size, dir);
+	return 0;
+}
+
+static int mrg5_dmabuf_end_cpu_access(struct dma_buf *dmabuf,
+				      enum dma_data_direction dir)
+{
+	struct drm_gem_object *obj = dmabuf->priv;
+	struct drm_gem_dma_object *dma = to_drm_gem_dma_obj(obj);
+
+	if (dir != DMA_FROM_DEVICE)
+		dma_sync_single_for_device(obj->dev->dev, dma->dma_addr,
+					   obj->size, dir);
+	return 0;
+}
+
+static const struct dma_buf_ops mrg5_dmabuf_ops = {
+	.attach = drm_gem_map_attach,
+	.detach = drm_gem_map_detach,
+	.map_dma_buf = drm_gem_map_dma_buf,
+	.unmap_dma_buf = drm_gem_unmap_dma_buf,
+	.release = drm_gem_dmabuf_release,
+	.mmap = mrg5_dmabuf_mmap,
+	.vmap = drm_gem_dmabuf_vmap,
+	.vunmap = drm_gem_dmabuf_vunmap,
+	.begin_cpu_access = mrg5_dmabuf_begin_cpu_access,
+	.end_cpu_access = mrg5_dmabuf_end_cpu_access,
+};
+
+static struct dma_buf *mrg5_gem_prime_export(struct drm_gem_object *obj,
+					     int flags)
+{
+	struct drm_device *dev = obj->dev;
+	struct dma_buf_export_info exp_info = {
+		.exp_name = KBUILD_MODNAME,
+		.owner = dev->driver->fops->owner,
+		.ops = &mrg5_dmabuf_ops,
+		.size = obj->size,
+		.flags = flags,
+		.priv = obj,
+		.resv = obj->resv,
+	};
+
+	return drm_gem_dmabuf_export(dev, &exp_info);
+}
+
+static struct drm_gem_object *mrg5_gem_prime_import(struct drm_device *dev,
+						    struct dma_buf *dmabuf)
+{
+	struct drm_gem_object *obj = dmabuf->priv;
+
+	if (dmabuf->ops == &mrg5_dmabuf_ops && obj->dev == dev) {
+		drm_gem_object_get(obj);
+		return obj;
+	}
+	return drm_gem_prime_import(dev, dmabuf);
+}
+
+static const struct drm_gem_object_funcs mrg5_gem_funcs = {
+	.free = drm_gem_dma_object_free,
+	.print_info = drm_gem_dma_object_print_info,
+	.get_sg_table = drm_gem_dma_object_get_sg_table,
+	.vmap = drm_gem_dma_object_vmap,
+	.mmap = drm_gem_dma_object_mmap,
+	.export = mrg5_gem_prime_export,
+	.vm_ops = &drm_gem_dma_vm_ops,
+};
+
+static struct drm_gem_object *mrg5_gem_create_object(struct drm_device *drm,
+						     size_t size)
+{
+	struct drm_gem_dma_object *dma = kzalloc(sizeof(*dma), GFP_KERNEL);
+
+	if (!dma)
+		return ERR_PTR(-ENOMEM);
+	dma->base.funcs = &mrg5_gem_funcs;
+	return &dma->base;
+}
+
+DEFINE_DRM_GEM_DMA_FOPS(mrg5_fops);
+
+static const struct drm_driver mrg5_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.fops = &mrg5_fops,
+	.gem_create_object = mrg5_gem_create_object,
+	.gem_prime_import = mrg5_gem_prime_import,
+	DRM_GEM_DMA_DRIVER_OPS,
+	.name = "mrg5",
+	.desc = "MRG5 BCM7268 display",
+	.major = 1,
+	.minor = 0,
+};
+
+static int mrg5_probe(struct platform_device *pdev)
+{
+	struct mrg5_drm *m;
+	struct drm_device *drm;
+	int ret;
+
+	ret = dma_coerce_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	m = devm_drm_dev_alloc(&pdev->dev, &mrg5_driver, struct mrg5_drm, drm);
+	if (IS_ERR(m))
+		return PTR_ERR(m);
+	drm = &m->drm;
+	platform_set_drvdata(pdev, drm);
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+	drm->mode_config.min_width = MRG5_W;
+	drm->mode_config.max_width = MRG5_W;
+	drm->mode_config.min_height = MRG5_H;
+	drm->mode_config.max_height = MRG5_H;
+	drm->mode_config.preferred_depth = 24;
+	drm->mode_config.funcs = &mrg5_mode_config_funcs;
+	drm->mode_config.async_page_flip = true;
+
+	m->period = ns_to_ktime(NSEC_PER_SEC / 50);
+	hrtimer_setup(&m->vblank_timer, mrg5_vblank_timer_fn, CLOCK_MONOTONIC,
+		      HRTIMER_MODE_REL);
+
+	drm_connector_helper_add(&m->connector, &mrg5_connector_helper_funcs);
+	ret = drm_connector_init(drm, &m->connector, &mrg5_connector_funcs,
+				 DRM_MODE_CONNECTOR_HDMIA);
+	if (ret)
+		return ret;
+
+	ret = drm_simple_display_pipe_init(drm, &m->pipe, &mrg5_pipe_funcs,
+					   mrg5_formats, ARRAY_SIZE(mrg5_formats),
+					   mrg5_modifiers, &m->connector);
+	if (ret)
+		return ret;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+
+	drm_info(drm, "1920x1080@50, scanout through the per-frame list\n");
+	return 0;
+}
+
+static void mrg5_remove(struct platform_device *pdev)
+{
+	struct drm_device *drm = platform_get_drvdata(pdev);
+
+	drm_dev_unregister(drm);
+	drm_atomic_helper_shutdown(drm);
+}
+
+static void mrg5_shutdown(struct platform_device *pdev)
+{
+	drm_atomic_helper_shutdown(platform_get_drvdata(pdev));
+}
+
+static const struct of_device_id mrg5_of_match[] = {
+	{ .compatible = "mrg5,kms" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mrg5_of_match);
+
+static struct platform_driver mrg5_platform_driver = {
+	.probe = mrg5_probe,
+	.remove = mrg5_remove,
+	.shutdown = mrg5_shutdown,
+	.driver = {
+		.name = "mrg5-drm",
+		.of_match_table = mrg5_of_match,
+	},
+};
+module_platform_driver(mrg5_platform_driver);
+
+MODULE_DESCRIPTION("MRG5 BCM7268 KMS");
+MODULE_LICENSE("GPL");
diff -ruN a/drivers/gpu/drm/v3d/v3d_bo.c b/drivers/gpu/drm/v3d/v3d_bo.c
--- a/drivers/gpu/drm/v3d/v3d_bo.c	2025-11-30 23:42:10.000000000 +0100
+++ b/drivers/gpu/drm/v3d/v3d_bo.c	2026-10-03 00:12:23.444784042 +0200
@@ -16,11 +16,215 @@
  */
 
 #include <linux/dma-buf.h>
+#include <linux/moduleparam.h>
 #include <linux/vmalloc.h>
 
 #include "v3d_drv.h"
 #include "uapi/drm/v3d_drm.h"
 
+#include <linux/genalloc.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+
+
+#define V3D33_PTE_WRITEABLE BIT(29)
+#define V3D33_PTE_VALID BIT(28)
+
+#define V3D33_CONTIG_PAD PAGE_SIZE
+
+static void v3d33_identity_ptes(struct v3d_bo *bo, bool map)
+{
+	struct v3d_dev *v3d = to_v3d_dev(bo->base.base.dev);
+	u32 npages = bo->node.size;
+	u32 page;
+
+	for (page = bo->node.start; page < bo->node.start + npages; page++)
+		v3d->pt[page] = map ? V3D33_PTE_WRITEABLE | V3D33_PTE_VALID | page : 0;
+
+	if (v3d_mmu_flush_all(v3d))
+		dev_err(v3d->drm.dev, "MMU flush timeout\n");
+}
+
+static void v3d33_contig_stats(struct v3d_dev *v3d, struct drm_gem_object *obj, int dir)
+{
+	mutex_lock(&v3d->bo_lock);
+	v3d->bo_stats.num_allocated += dir;
+	v3d->bo_stats.pages_allocated += dir * (int)(obj->size >> V3D_MMU_PAGE_SHIFT);
+	mutex_unlock(&v3d->bo_lock);
+}
+
+static void v3d33_contig_free(struct drm_gem_object *obj)
+{
+	struct v3d_dev *v3d = to_v3d_dev(obj->dev);
+	struct v3d_bo *bo = to_v3d_bo(obj);
+
+	if (bo->vaddr)
+		v3d_put_bo_vaddr(bo);
+	v3d33_identity_ptes(bo, false);
+	v3d33_contig_stats(v3d, obj, -1);
+	gen_pool_free(v3d->contig_pool, bo->contig_phys,
+		      (size_t)bo->node.size << V3D_MMU_PAGE_SHIFT);
+	drm_gem_free_mmap_offset(obj);
+	drm_gem_object_release(obj);
+	kfree(bo);
+}
+
+static int v3d33_contig_mmap(struct drm_gem_object *obj, struct vm_area_struct *vma)
+{
+	struct v3d_bo *bo = to_v3d_bo(obj);
+	unsigned long len = vma->vm_end - vma->vm_start;
+
+	vma->vm_pgoff -= drm_vma_node_start(&obj->vma_node);
+	if ((vma->vm_pgoff << PAGE_SHIFT) + len > obj->size)
+		return -EINVAL;
+	vm_flags_set(vma, VM_IO | VM_PFNMAP | VM_DONTEXPAND | VM_DONTDUMP);
+	vma->vm_page_prot = pgprot_writecombine(vm_get_page_prot(vma->vm_flags));
+	return remap_pfn_range(vma, vma->vm_start,
+			       (bo->contig_phys >> PAGE_SHIFT) + vma->vm_pgoff,
+			       len, vma->vm_page_prot);
+}
+
+static int v3d33_contig_vmap(struct drm_gem_object *obj, struct iosys_map *map)
+{
+	void *vaddr = memremap(to_v3d_bo(obj)->contig_phys, obj->size, MEMREMAP_WC);
+
+	if (!vaddr)
+		return -ENOMEM;
+	iosys_map_set_vaddr(map, vaddr);
+	return 0;
+}
+
+static void v3d33_contig_vunmap(struct drm_gem_object *obj, struct iosys_map *map)
+{
+	memunmap(map->vaddr);
+}
+
+static struct sg_table *v3d33_contig_get_sg_table(struct drm_gem_object *obj)
+{
+	return ERR_PTR(-EOPNOTSUPP);
+}
+
+static const struct vm_operations_struct v3d33_contig_vm_ops = {
+	.open = drm_gem_vm_open,
+	.close = drm_gem_vm_close,
+};
+
+static const struct drm_gem_object_funcs v3d33_contig_funcs = {
+	.free = v3d33_contig_free,
+	.mmap = v3d33_contig_mmap,
+	.vmap = v3d33_contig_vmap,
+	.vunmap = v3d33_contig_vunmap,
+	.get_sg_table = v3d33_contig_get_sg_table,
+	.vm_ops = &v3d33_contig_vm_ops,
+};
+
+static struct v3d_bo *v3d33_contig_bo_create(struct drm_device *dev, size_t unaligned_size)
+{
+	struct v3d_dev *v3d = to_v3d_dev(dev);
+	size_t size = PAGE_ALIGN(unaligned_size);
+	size_t alloc = size + V3D33_CONTIG_PAD;
+	struct drm_gem_object *obj;
+	struct v3d_bo *bo;
+	unsigned long phys;
+	void *zero;
+	int ret;
+
+	if (!size)
+		return ERR_PTR(-EINVAL);
+	phys = gen_pool_alloc(v3d->contig_pool, alloc);
+	if (!phys)
+		return ERR_PTR(-ENOMEM);
+
+	zero = memremap(phys, alloc, MEMREMAP_WC);
+	if (!zero) {
+		gen_pool_free(v3d->contig_pool, phys, alloc);
+		return ERR_PTR(-ENOMEM);
+	}
+	memset(zero, 0, alloc);
+	memunmap(zero);
+
+	bo = kzalloc(sizeof(*bo), GFP_KERNEL);
+	if (!bo) {
+		gen_pool_free(v3d->contig_pool, phys, alloc);
+		return ERR_PTR(-ENOMEM);
+	}
+	obj = &bo->base.base;
+	obj->funcs = &v3d33_contig_funcs;
+	INIT_LIST_HEAD(&bo->unref_head);
+	drm_gem_private_object_init(dev, obj, size);
+	ret = drm_gem_create_mmap_offset(obj);
+	if (ret) {
+		drm_gem_object_release(obj);
+		kfree(bo);
+		gen_pool_free(v3d->contig_pool, phys, alloc);
+		return ERR_PTR(ret);
+	}
+
+	bo->contig_phys = phys;
+	bo->identity = true;
+	bo->node.start = phys >> V3D_MMU_PAGE_SHIFT;
+	bo->node.size = alloc >> V3D_MMU_PAGE_SHIFT;
