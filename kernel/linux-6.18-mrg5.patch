+static int mrg5_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mrg5_hdmi *m;
+	struct snd_card *card;
+	struct snd_pcm *pcm;
+	unsigned int i;
+	int err;
+
+	err = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (err)
+		return dev_err_probe(dev, err, "no 32-bit DMA mask\n");
+
+	err = snd_card_new(dev, SNDRV_DEFAULT_IDX1, "MRG5HDMI", THIS_MODULE,
+			   sizeof(*m), &card);
+	if (err < 0)
+		return err;
+
+	m = card->private_data;
+	m->dev = dev;
+	m->card = card;
+	m->volume = MRG5_VOL_MAX;
+	m->muted = false;
+	spin_lock_init(&m->lock);
+	mutex_init(&m->standby_lock);
+
+	m->aio = devm_ioremap(dev, MRG5_AIO_PHYS, MRG5_AIO_SIZE);
+	m->mai = devm_ioremap(dev, MRG5_MAI_PHYS, MRG5_MAI_SIZE);
+	m->hdmi = devm_ioremap(dev, MRG5_HDMI_PHYS, MRG5_HDMI_SIZE);
+	if (!m->aio || !m->mai || !m->hdmi) {
+		err = -ENOMEM;
+		goto err_card;
+	}
+
+	m->ring = dmam_alloc_coherent(dev, MRG5_RING_BYTES, &m->ring_dma, GFP_KERNEL);
+	if (!m->ring) {
+		dev_err(dev, "cannot allocate a %u-byte coherent ring\n", MRG5_RING_BYTES);
+		err = -ENOMEM;
+		goto err_card;
+	}
+	if (m->ring_dma + MRG5_RING_BYTES > 0x80000000ULL) {
+		dev_err(dev, "ring at %pad is above 2 GiB; bit 31 of the position registers is the generation flag\n",
+			&m->ring_dma);
+		err = -ERANGE;
+		goto err_card;
+	}
+	m->ring_base = lower_32_bits(m->ring_dma);
+
+	err = snd_pcm_new(card, "MRG5 HDMI", 0, 1, 0, &pcm);
+	if (err < 0)
+		goto err_card;
+
+	pcm->private_data = m;
+	strscpy(pcm->name, "MRG5 HDMI", sizeof(pcm->name));
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK, &mrg5_pcm_ops);
+	snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_VMALLOC, dev,
+				       MRG5_BUF_BYTES, MRG5_BUF_BYTES);
+	m->pcm = pcm;
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_controls); i++) {
+		err = snd_ctl_add(card, snd_ctl_new1(&mrg5_controls[i], m));
+		if (err < 0)
+			goto err_card;
+	}
+
+	strscpy(card->driver, "mrg5-hdmi", sizeof(card->driver));
+	strscpy(card->shortname, "MRG5 HDMI", sizeof(card->shortname));
+	snprintf(card->longname, sizeof(card->longname),
+		 "MagentaTV Box HDMI audio (BCM7268), 48 kHz S16_LE stereo");
+
+	mrg5_path_up(m);
+
+	hrtimer_setup(&m->timer, mrg5_tick, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	hrtimer_start(&m->timer, ns_to_ktime(MRG5_TICK_NS), HRTIMER_MODE_REL);
+
+	err = snd_card_register(card);
+	if (err < 0)
+		goto err_timer;
+
+	platform_set_drvdata(pdev, m);
+	dev_info(dev, "HDMI audio ready: 48 kHz S16_LE stereo, ring streaming continuously\n");
+	return 0;
+
+err_timer:
+	hrtimer_cancel(&m->timer);
+	mrg5_path_down(m);
+err_card:
+	snd_card_free(card);
+	return err;
+}
+
+static void mrg5_remove(struct platform_device *pdev)
+{
+	struct mrg5_hdmi *m = platform_get_drvdata(pdev);
+
+	hrtimer_cancel(&m->timer);
+	mrg5_path_down(m);
+	snd_card_free(m->card);
+}
+
+static struct platform_driver mrg5_hdmi_driver = {
+	.driver = { .name = DRV_NAME, .dev_groups = mrg5_groups },
+	.probe = mrg5_probe,
+	.remove = mrg5_remove,
+};
+
+static struct platform_device *mrg5_hdmi_pdev;
+
+static int __init mrg5_hdmi_init(void)
+{
+	int err = platform_driver_register(&mrg5_hdmi_driver);
+
+	if (err)
+		return err;
+
+	mrg5_hdmi_pdev = platform_device_register_simple(DRV_NAME, -1, NULL, 0);
+	if (IS_ERR(mrg5_hdmi_pdev)) {
+		platform_driver_unregister(&mrg5_hdmi_driver);
+		return PTR_ERR(mrg5_hdmi_pdev);
+	}
+	return 0;
+}
+
+static void __exit mrg5_hdmi_exit(void)
+{
+	platform_device_unregister(mrg5_hdmi_pdev);
+	platform_driver_unregister(&mrg5_hdmi_driver);
+}
+
+late_initcall(mrg5_hdmi_init);
+__exitcall(mrg5_hdmi_exit);
+
+MODULE_DESCRIPTION("HDMI audio for the MagentaTV Box (MRG5 / BCM7268)");
+MODULE_LICENSE("GPL");
