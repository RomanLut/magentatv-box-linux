diff -ruN a/arch/arm/mach-bcm/mrg5-splash.c b/arch/arm/mach-bcm/mrg5-splash.c
--- a/arch/arm/mach-bcm/mrg5-splash.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/arm/mach-bcm/mrg5-splash.c	2026-10-03 00:12:23.353116729 +0200
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/sizes.h>
+#include <linux/mm.h>
+#include <linux/delay.h>
+#include <linux/uaccess.h>
+#include <linux/memblock.h>
+#include <linux/platform_device.h>
+#include <linux/platform_data/simplefb.h>
+
+#include <asm/mach/map.h>
+#include <asm/memory.h>
+
+#define MRG5_RDB_PHYS	0xf0000000u
+#define MRG5_RDB_VIRT	0xf0000000u
+#define MRG5_RDB_SIZE	0x01200000u
+
+#define MRG5_SRR_PHYS	0xbd700000u
+#define MRG5_FB_OFF	0x00017000u
+#define MRG5_LISTS_OFF	0x01000000u
+#define MRG5_SRR_VIRT	0xf2000000u
+#define MRG5_SRR_SIZE	0x00800000u
+
+#define MRG5_FB_SIZE	(1920u * 1080u * 4u)
+#define MRG5_FB_FILL	0x80
+
+#define MRG5_RDC_LISTS	1
+#define MRG5_PMAP_APPLY	0
+
+#define MRG5_LIST_TAILS	0
+
+#define MRG5_FULL_DUMP	0
+
+
+#include "mrg5-pmap-table.h"
+#include "mrg5-splash-table.h"
+#include "mrg5-rdc-table.h"
+#include "mrg5-boot-table.h"
+#include "mrg5-dump-table.h"
+#include "mrg5-loopc-table.h"
+
+void __init mrg5_reserve(void);
+void __init mrg5_map_io(void);
+void __init mrg5_splash_apply(void);
+
+static struct map_desc mrg5_io_desc[] __initdata = {
+	{
+		.virtual	= MRG5_RDB_VIRT,
+		.pfn		= __phys_to_pfn(MRG5_RDB_PHYS),
+		.length		= MRG5_RDB_SIZE,
+		.type		= MT_DEVICE,
+	},
+	{
+		.virtual	= MRG5_SRR_VIRT,
+		.pfn		= __phys_to_pfn(MRG5_SRR_PHYS),
+		.length		= MRG5_SRR_SIZE,
+		.type		= MT_UNCACHED,
+	},
+};
+
+void __init mrg5_reserve(void)
+{
+	memblock_remove(MRG5_SRR_PHYS, MRG5_SRR_SIZE);
+}
+
+void __init mrg5_map_io(void)
+{
+	iotable_init(mrg5_io_desc, ARRAY_SIZE(mrg5_io_desc));
+}
+
+static inline void mrg5_wr(u32 pa, u32 val)
+{
+	if (pa < MRG5_RDB_PHYS || pa >= MRG5_RDB_PHYS + MRG5_RDB_SIZE)
+		return;
+	writel_relaxed(val, (void __iomem *)(MRG5_RDB_VIRT + (pa - MRG5_RDB_PHYS)));
+}
+
+static inline u32 mrg5_rd(u32 pa)
+{
+	if (pa < MRG5_RDB_PHYS || pa >= MRG5_RDB_PHYS + MRG5_RDB_SIZE)
+		return 0;
+	return readl_relaxed((void __iomem *)(MRG5_RDB_VIRT + (pa - MRG5_RDB_PHYS)));
+}
+
+static void __init mrg5_stage_a(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_splash_regs); i++)
+		mrg5_wr(mrg5_splash_regs[i][0], mrg5_splash_regs[i][1]);
+}
+
+static void __init mrg5_stage_b(void __iomem *fb, u32 fb_phys)
+{
+	{
+		unsigned int i;
+
+		pr_info("mrg5: B clear fb %08x\n", fb_phys);
+		for (i = 0; i < 1920 * 1080; i++)
+			writel_relaxed(0xff000000, fb + 4 * i);
+	}
+
+	pr_info("mrg5: B write f060348c/f0603490\n");
+	mrg5_wr(0xf060348c, fb_phys);
+	mrg5_wr(0xf0603490, fb_phys);
+	mrg5_wr(0xf0603494, 0);
+	pr_info("mrg5: B done\n");
+}
+
+static void __init mrg5_stage_c_traced(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_loopc_ops); i++) {
+		u32 a = mrg5_loopc_ops[i][0], v = mrg5_loopc_ops[i][1];
+
+		if (a >= MRG5_RDB_PHYS)
+			mrg5_wr(a, v);
+		else
+			writel_relaxed(v, (void __iomem *)(MRG5_SRR_VIRT +
+							   (a - MRG5_SRR_PHYS)));
+	}
+}
+
+static void __init __maybe_unused mrg5_stage_c(u32 __iomem *dst, u32 lists_phys)
+{
+	u32 first[2] = { 0, 0 };
+	u32 len0[2] = { 0, 0 };
+	unsigned int i, j, k;
+
+	pr_info("mrg5: C copy %u lists to %08x\n",
+		(unsigned int)ARRAY_SIZE(mrg5_rdc_lists), lists_phys);
+
+	mrg5_wr(0xf0605000, 0);
+	for (i = 0; i < ARRAY_SIZE(mrg5_rdc_words); i++)
+		writel_relaxed(mrg5_rdc_words[i], &dst[i]);
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_rdc_lists); i++) {
+		const struct mrg5_rdc_list *l = &mrg5_rdc_lists[i];
+
+		for (j = 0; j <= l->len; j++) {
+			u32 w = readl_relaxed(&dst[l->off + j]);
+
+			for (k = 0; k < ARRAY_SIZE(mrg5_rdc_lists); k++)
+				if (w == mrg5_rdc_lists[k].orig)
+					writel_relaxed(lists_phys + 4 * mrg5_rdc_lists[k].off,
+						       &dst[l->off + j]);
+		}
+
+		if (!first[l->slot]) {
+			first[l->slot] = lists_phys + 4 * l->off;
+			len0[l->slot] = l->len;
+		}
+
+		if (!MRG5_LIST_TAILS)
+			writel_relaxed(0, &dst[l->off + l->len]);
+	}
+
+	if (MRG5_RDC_LISTS) {
+		for (i = 0; i < 2; i++) {
+			u32 s = 0xf0604000u + 0x40u * i;
+
+			pr_info("mrg5: C slot%u first=%08x len=%u\n",
+				i, first[i], len0[i]);
+			mrg5_wr(s + 0x00, first[i]);
+			mrg5_wr(s + 0x04, 0);
+			mrg5_wr(s + 0x08, len0[i]);
+			mrg5_wr(s + 0x10, i ? 0x06190000u : 0x06180000u);
+			mrg5_wr(s + 0x18, len0[i]);
+			mrg5_wr(s + 0x20, len0[i]);
+			mrg5_wr(s + 0x28, 5);
+		}
+	} else {
+		pr_info("mrg5: C slots NOT programmed (MRG5_RDC_LISTS=0)\n");
+	}
+
+	pr_info("mrg5: C bootstrap %u flat register ops\n",
+		(unsigned int)ARRAY_SIZE(mrg5_boot_regs));
+	for (i = 0; i < ARRAY_SIZE(mrg5_boot_regs); i++) {
+		u32 a = mrg5_boot_regs[i][0], v = mrg5_boot_regs[i][1];
+		u32 m = mrg5_boot_regs[i][2];
+
+		if (m)
+			v = (mrg5_rd(a) & ~m) | (v & m);
+		mrg5_wr(a, v);
+	}
+	pr_info("mrg5: C bootstrap done\n");
+
+	if (MRG5_RDC_LISTS) {
+		pr_info("mrg5: C enable f0605000=3\n");
+		mrg5_wr(0xf0605000, 3);
+		pr_info("mrg5: C slots enabled\n");
+	} else {
+		pr_info("mrg5: C left disabled, flat table only\n");
+	}
+
+	for (i = 0; i < 2; i++) {
+		if (i)
+			mdelay(200);
+		pr_info("mrg5: s%u slot0=%08x cnt=%08x slot1=%08x cnt=%08x stat=%08x\n",
+			i, mrg5_rd(0xf0604000), mrg5_rd(0xf0604008),
+			mrg5_rd(0xf0604040), mrg5_rd(0xf0604048),
+			mrg5_rd(0xf0605004));
+		pr_info("mrg5: s%u raster=%08x total=%08x phy=%08x/%08x enc=%08x/%08x scan=%08x\n",
+			i, mrg5_rd(0xf06fa138), mrg5_rd(0xf06fa154),
+			mrg5_rd(0xf06f8014), mrg5_rd(0xf06f8018),
+			mrg5_rd(0xf0641008), mrg5_rd(0xf0641044),
+			mrg5_rd(0xf06e703c));
+	}
+	pr_info("mrg5: BLS2 had raster=02100780 total=002c0a24 phy=0000971e/000fd200 enc=00000001/00000780\n");
+
+	mrg5_wr(0xf0641008, 1);
+	mdelay(100);
+	pr_info("mrg5: enc asserted, reads %08x\n", mrg5_rd(0xf0641008));
+
+	{
+		if (MRG5_FULL_DUMP) {
+			pr_info("mrg5: DUMPBEGIN\n");
+			for (i = 0; i < ARRAY_SIZE(mrg5_dump_addrs); i++)
+				pr_info("D %08x %08x\n", mrg5_dump_addrs[i],
+					mrg5_rd(mrg5_dump_addrs[i]));
+			pr_info("mrg5: DUMPEND\n");
+		}
+	}
+
+}
+
+struct mrg5_sample {
+	u32 phy, phy2, enc, raster, scan;
+};
+
+static struct mrg5_sample mrg5_early[3] __initdata;
+static u32 mrg5_mux_reset[ARRAY_SIZE(mrg5_pmap_mux)] __initdata;
+static u32 mrg5_mux_after[ARRAY_SIZE(mrg5_pmap_mux)] __initdata;
+
+static void __init mrg5_sample(struct mrg5_sample *s)
+{
+	s->phy    = mrg5_rd(0xf06f8014);
+	s->phy2   = mrg5_rd(0xf06f8018);
+	s->enc    = mrg5_rd(0xf0641008);
+	s->raster = mrg5_rd(0xf06fa138);
+	s->scan   = mrg5_rd(0xf06e703c);
+}
+
+static void __init mrg5_report(const char *when, const struct mrg5_sample *s)
+{
+	pr_info("mrg5: probe %s phy=%08x/%08x enc=%08x raster=%08x scan=%08x\n",
+		when, s->phy, s->phy2, s->enc, s->raster, s->scan);
+}
+
+static void __init mrg5_probe(const char *when)
+{
+	struct mrg5_sample s;
+
+	mrg5_sample(&s);
+	mrg5_report(when, &s);
+}
+
+static void __init mrg5_stage_pmap(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_pmap_mux); i++)
+		mrg5_mux_reset[i] = mrg5_rd(mrg5_pmap_mux[i]);
+
+	if (MRG5_PMAP_APPLY) {
+		for (i = 0; i < ARRAY_SIZE(mrg5_pmap_regs); i++) {
+			u32 a = mrg5_pmap_regs[i][0], v = mrg5_pmap_regs[i][1];
+			u32 m = mrg5_pmap_regs[i][2];
+
+			mrg5_wr(a, (mrg5_rd(a) & ~m) | (v & m));
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_pmap_mux); i++)
+		mrg5_mux_after[i] = mrg5_rd(mrg5_pmap_mux[i]);
+}
+
+void __init mrg5_splash_apply(void)
+{
+	mrg5_sample(&mrg5_early[0]);
+	mrg5_stage_pmap();
+	mrg5_sample(&mrg5_early[1]);
+	mrg5_stage_a();
+	mrg5_sample(&mrg5_early[2]);
+
+	mrg5_stage_b((void __iomem *)(MRG5_SRR_VIRT + MRG5_FB_OFF),
+		     MRG5_SRR_PHYS + MRG5_FB_OFF);
+	mrg5_stage_c_traced();
+}
+
+static int __init mrg5_splash_late(void)
+{
+	unsigned int i;
+
+	pr_info("mrg5: A applied early (%u writes), pmap_apply=%d rdc_lists=%d tails=%d\n",
+		(unsigned int)ARRAY_SIZE(mrg5_splash_regs),
+		MRG5_PMAP_APPLY, MRG5_RDC_LISTS, MRG5_LIST_TAILS);
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_pmap_mux); i++)
+		pr_info("mrg5: pmap mux %08x reset=%08x now=%08x\n",
+			mrg5_pmap_mux[i], mrg5_mux_reset[i], mrg5_mux_after[i]);
+	mrg5_report("pre-0 ", &mrg5_early[0]);
+	mrg5_report("pre-A ", &mrg5_early[1]);
+	mrg5_report("post-A", &mrg5_early[2]);
+	mrg5_probe("late  ");
+
+	pr_info("mrg5: C slot0 %08x\n", mrg5_rd(0xf0604000));
+	mdelay(200);
+	pr_info("mrg5: C slot0 %08x\n", mrg5_rd(0xf0604000));
+
+	return 0;
+}
+late_initcall(mrg5_splash_late);
+
+static int __init mrg5_fb_register(void)
+{
+	static const struct simplefb_platform_data pdata = {
+		.width	= 1920,
+		.height	= 1080,
+		.stride	= 1920 * 4,
+		.format	= "a8r8g8b8",
+	};
+	struct resource res = DEFINE_RES_MEM(MRG5_SRR_PHYS + MRG5_FB_OFF,
+					     1920 * 4 * 1080);
+	struct platform_device *pd;
+
+	pd = platform_device_register_resndata(NULL, "simple-framebuffer", 0,
+					       &res, 1, &pdata, sizeof(pdata));
+	pr_info("mrg5: simple-framebuffer %pR %s\n", &res,
+		IS_ERR(pd) ? "FAILED" : "registered");
+	return PTR_ERR_OR_ZERO(pd);
+}
+device_initcall(mrg5_fb_register);
