+	{ 0xf04e04d0u, 0x00000000u, 0x00000003u },
+	{ 0xf04e0510u, 0x00000000u, 0x00000001u },
+};
+
+static const u32 mrg5_pmap_mux[] __initconst = {
+	0xf04e0318u,
+	0xf04e0374u,
+	0xf04e0400u,
+	0xf04e0410u,
