+static ssize_t standby_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mrg5_hdmi *m = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", m->standby);
+}
+
+static ssize_t standby_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct mrg5_hdmi *m = dev_get_drvdata(dev);
+	bool on;
+	int err = kstrtobool(buf, &on);
+
+	if (err)
+		return err;
+	mutex_lock(&m->standby_lock);
+	if (on != m->standby) {
+		if (on) {
+			hrtimer_cancel(&m->timer);
+			mrg5_path_down(m);
+			hdmi_wr(m, HDMI_TX_PHY_CTL_1, hdmi_rd(m, HDMI_TX_PHY_CTL_1) | HDMI_TMDS_OFF);
+		} else {
+			hdmi_wr(m, HDMI_TX_PHY_CTL_1, hdmi_rd(m, HDMI_TX_PHY_CTL_1) & ~HDMI_TMDS_OFF);
+			hdmi_wr(m, HDMI_TX_PHY_CTL_0, hdmi_rd(m, HDMI_TX_PHY_CTL_0) & ~HDMI_TMDS_OFF);
+			mrg5_path_up(m);
+			hrtimer_start(&m->timer, ns_to_ktime(MRG5_TICK_NS), HRTIMER_MODE_REL);
+		}
+		m->standby = on;
+		dev_info(dev, "standby %s: audio ring %s, TMDS outputs %s\n", on ? "on" : "off",
+			 on ? "stopped" : "running", on ? "off" : "on");
+	}
+	mutex_unlock(&m->standby_lock);
+	return count;
+}
