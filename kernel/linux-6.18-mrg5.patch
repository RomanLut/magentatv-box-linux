+++ b/arch/arm/mach-bcm/mrg5-rdc-table.h	2026-10-03 00:12:23.329203517 +0200
@@ -0,0 +1,241 @@
+static const u32 mrg5_rdc_words[] __initconst = {
+	0x01000000u, 0xf0645864u, 0xbaadf00du, 0x01000000u, 0xf0605000u, 0x00000000u, 0x01000000u, 0xf0604000u,
+	0xbd716000u, 0x01000000u, 0xf0604010u, 0x06180000u, 0x01000000u, 0xf0604008u, 0x00000052u, 0x01000000u,
+	0xf0604018u, 0x00000052u, 0x00000000u, 0x01000000u, 0xf0645844u, 0x00000013u, 0x01000000u, 0xf0645840u,
+	0x00000100u, 0x06000001u, 0xf064580cu, 0x0780021cu, 0x0018b87bu, 0x01000000u, 0xf0645814u, 0x000f0000u,
+	0x01000000u, 0xf0645818u, 0x000f0000u, 0x01000000u, 0xf064581cu, 0x000f0000u, 0x01000000u, 0xf0645828u,
