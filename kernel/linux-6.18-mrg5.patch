+		    a >= MRG5_AUDIO_WINDOW_BASE + MRG5_AUDIO_WINDOW_SIZE)
+			continue;
+		pr_info("mrg5-audio: %s 0x%08x = 0x%08x\n", when, a,
+			readl(base + (a - MRG5_AUDIO_WINDOW_BASE)));
+	}
+}
+
+static bool __init mrg5_audio_watched(u32 addr)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_audio_watch); i++)
+		if (mrg5_audio_watch[i] == addr)
+			return true;
+	return false;
+}
+
+static int __init mrg5_audio_init(void)
+{
+	void __iomem *base;
+	unsigned int i, applied = 0, skipped = 0;
+
+	base = ioremap(MRG5_AUDIO_WINDOW_BASE, MRG5_AUDIO_WINDOW_SIZE);
+	if (!base) {
+		pr_err("mrg5-audio: ioremap of 0x%08x failed\n", MRG5_AUDIO_WINDOW_BASE);
+		return -ENOMEM;
+	}
+
+	mrg5_audio_watch_dump(base, "before:");
+
+	for (i = 0; i < MRG5_AUDIO_INIT_OPS; i++) {
+		const struct mrg5_audio_regop *op = &mrg5_audio_init_regs[i];
+		void __iomem *reg;
+		u32 v;
+
+		if (op->addr < MRG5_AUDIO_WINDOW_BASE ||
+		    op->addr >= MRG5_AUDIO_WINDOW_BASE + MRG5_AUDIO_WINDOW_SIZE) {
+			pr_warn("mrg5-audio: op %u address 0x%08x outside the window\n",
+				i, op->addr);
+			skipped++;
+			continue;
+		}
+		reg = base + (op->addr - MRG5_AUDIO_WINDOW_BASE);
+
+		if (op->kind == 0) {
+			writel(op->value, reg);
+		} else {
+			u32 nv;
+
+			v = readl(reg);
+			nv = (v & ~op->mask) | op->value;
+			writel(nv, reg);
+			if (mrg5_audio_watched(op->addr))
+				pr_info("mrg5-audio: rmw 0x%08x read 0x%08x mask 0x%08x wrote 0x%08x readback 0x%08x\n",
+					op->addr, v, op->mask, nv, readl(reg));
+		}
+		applied++;
+	}
+
+	mrg5_audio_watch_dump(base, "after:");
+	iounmap(base);
+	pr_info("mrg5-audio: applied %u register operations (%u skipped)\n", applied, skipped);
+	return 0;
+}
+late_initcall(mrg5_audio_init);
