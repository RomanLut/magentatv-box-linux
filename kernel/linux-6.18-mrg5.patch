+#include <linux/uaccess.h>
+
+#include <asm/cacheflush.h>
+#include <asm/memory.h>
+#include <asm/outercache.h>
+#include <asm/smp.h>
+
+#include "mrg5-trampoline.h"
+
+#ifndef MRG5_CPUPROBE
+#define MRG5_CPUPROBE	0
+#endif
+
+unsigned long mrg5_smp_boot_addr(unsigned int cpu);
+
+#define MRG5_SMPSTAGE_MAX	6
+static unsigned int mrg5_smpstage = 6;
+
+static int __init mrg5_smpstage_setup(char *s)
+{
+	unsigned int v;
+
+	if (!kstrtouint(s, 0, &v) && v <= MRG5_SMPSTAGE_MAX)
+		mrg5_smpstage = v;
+	return 1;
+}
+__setup("mrg5.smpstage=", mrg5_smpstage_setup);
+
+#define MRG5_SMP_PAGES	2
+#define TRAMPOLINE	0x0000u
+#define PROBE_A32	0x1000u
+#define PROBE_A64	0x1080u
+#define MARK_A32	0x1100u
+#define MARK_A64	0x1200u
+#define MARK_TRAMP	0x1300u
+
+#define GIC_DIST_DEFAULT	0xffd01000u
+#define GIC_CPU_DEFAULT		0xffd02000u
+
+static u8 mrg5_smp_page[MRG5_SMP_PAGES * PAGE_SIZE] __aligned(PAGE_SIZE);
+
+static const u32 probe_a32[] = {
+	0xe59f0018, 0xe59f1018, 0xe10f2000, 0xe5801000, 0xe5802004,
+	0xf57ff04f, 0xe320f002, 0xeafffffd, 0 , 0xa32a32a3,
+};
+
+static const u32 probe_a64[] = {
+	0x58000100, 0x18000121, 0xd5384242, 0xb9000001, 0xf9000402,
+	0xd5033f9f, 0xd503205f, 0x17ffffff, 0 , 0 ,
+	0xa64a64a6,
+};
+
+static void mrg5_smp_flush(void)
+{
+	phys_addr_t pa = __pa(mrg5_smp_page);
+
+	__cpuc_flush_dcache_area(mrg5_smp_page, sizeof(mrg5_smp_page));
+	outer_flush_range(pa, pa + sizeof(mrg5_smp_page));
+}
+
+static void mrg5_smp_gic_bases(u32 *dist, u32 *cpuif)
+{
+	struct device_node *np;
+	struct resource r;
+
+	*dist = GIC_DIST_DEFAULT;
+	*cpuif = GIC_CPU_DEFAULT;
+
+	np = of_find_compatible_node(NULL, NULL, "arm,cortex-a15-gic");
+	if (!np)
+		return;
+	if (!of_address_to_resource(np, 0, &r))
+		*dist = r.start;
+	if (!of_address_to_resource(np, 1, &r))
+		*cpuif = r.start;
+	of_node_put(np);
+}
+
+static u32 mrg5_smp_cntfrq(void)
+{
+	u32 f;
+
+	asm volatile("mrc p15, 0, %0, c14, c0, 0" : "=r" (f));
+	return f;
+}
+
+static void mrg5_smp_prepare_page(void)
+{
+	u32 *tramp = (u32 *)(mrg5_smp_page + TRAMPOLINE);
+	u32 *params;
+	phys_addr_t pa = __pa(mrg5_smp_page);
+	u32 dist, cpuif;
+	unsigned int i;
+
+	memset(mrg5_smp_page, 0, sizeof(mrg5_smp_page));
+	for (i = 0; i < ARRAY_SIZE(mrg5_trampoline); i++)
+		tramp[i] = mrg5_trampoline[i];
+
+	mrg5_smp_gic_bases(&dist, &cpuif);
+	params = (u32 *)(mrg5_smp_page + TRAMPOLINE + MRG5_TRAMPOLINE_PARAMS);
+	params[0] = __pa_symbol(secondary_startup_arm);
+	params[1] = mrg5_smp_cntfrq();
+	params[2] = dist;
+	params[3] = cpuif;
+	params[4] = pa + MARK_TRAMP;
+	params[5] = mrg5_smpstage;
+
+	if (MRG5_CPUPROBE) {
+		u32 *p32 = (u32 *)(mrg5_smp_page + PROBE_A32);
+		u32 *p64 = (u32 *)(mrg5_smp_page + PROBE_A64);
+
+		params[0] = pa + PROBE_A32;
+
+		for (i = 0; i < ARRAY_SIZE(probe_a32); i++)
+			p32[i] = probe_a32[i];
+		p32[8] = pa + MARK_A32;
+		for (i = 0; i < ARRAY_SIZE(probe_a64); i++)
+			p64[i] = probe_a64[i];
+		p64[8] = pa + MARK_A64;
+	}
+
+	mrg5_smp_flush();
+	pr_info("mrg5-smp: page at %08llx, entry %08x, cntfrq %u, gic %08x/%08x, stage %u\n",
+		(unsigned long long)pa, params[0], params[1], dist, cpuif,
+		mrg5_smpstage);
+}
+
+unsigned long mrg5_smp_boot_addr(unsigned int cpu)
+{
+	static bool prepared;
+
+	if (!prepared) {
+		mrg5_smp_prepare_page();
+		prepared = true;
+	}
+
+	if (MRG5_CPUPROBE && cpu == 1)
+		return __pa(mrg5_smp_page) + PROBE_A64;
+
+	return __pa(mrg5_smp_page) + TRAMPOLINE;
+}
+
+void mrg5_smp_mark(char c)
+{
+	void __iomem *uart = (void __iomem *)0xf040c000u;
+	unsigned int i;
+
+	for (i = 0; i < 100000; i++)
+		if (readl(uart + 0x14) & 0x20)
+			break;
+	writel((u8)c, uart);
+}
+
+static int __init mrg5_smp_report(void)
+{
+	const u32 *m32 = (const u32 *)(mrg5_smp_page + MARK_A32);
+	const u32 *m64 = (const u32 *)(mrg5_smp_page + MARK_A64);
+	const u32 *mt = (const u32 *)(mrg5_smp_page + MARK_TRAMP);
+
+	mrg5_smp_flush();
+	pr_info("mrg5-smp: trampoline reached step %u (currentel %08x)\n",
+		mt[0], mt[1]);
+	if (!MRG5_CPUPROBE)
+		return 0;
+	pr_info("mrg5-smp: arm32 probe marker %08x cpsr %08x\n", m32[0], m32[1]);
+	pr_info("mrg5-smp: aarch64 probe marker %08x currentel %08x\n",
+		m64[0], m64[2]);
+	return 0;
+}
+late_initcall(mrg5_smp_report);
+
+static int mrg5_actlr_show(struct seq_file *m, void *v)
+{
+	u32 a;
+
+	asm volatile("mrc p15, 0, %0, c1, c0, 1" : "=r" (a));
+	seq_printf(m, "cpu%u actlr %08x\n", smp_processor_id(), a);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mrg5_actlr);
+
+static int mrg5_cpuectlr_show(struct seq_file *m, void *v)
+{
+	u32 lo, hi;
+
+	asm volatile("mrrc p15, 1, %0, %1, c15" : "=r" (lo), "=r" (hi));
+	seq_printf(m, "cpu%u cpuectlr %08x%08x (smpen %u)\n",
+		   smp_processor_id(), hi, lo, (lo >> 6) & 1);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mrg5_cpuectlr);
+
+static ssize_t mrg5_smpen_write(struct file *f, const char __user *buf,
+				size_t len, loff_t *pos)
+{
+	u32 a, lo, hi;
+	char c;
+
+	if (!len || get_user(c, buf))
+		return -EFAULT;
+	if (c != 'a' && c != 'r' && c != 's')
+		return -EINVAL;
+
+	preempt_disable();
+	mrg5_smp_mark('<');
+	mrg5_smp_mark(c);
+	if (c == 'a') {
+		asm volatile("mrc p15, 0, %0, c1, c0, 1" : "=r" (a));
+		a |= 2;
+		asm volatile("mcr p15, 0, %0, c1, c0, 1\n\tisb" : : "r" (a));
+	} else {
+		asm volatile("mrrc p15, 1, %0, %1, c15" : "=r" (lo), "=r" (hi));
+		if (c == 's')
+			lo |= 1 << 6;
+		asm volatile("mcrr p15, 1, %0, %1, c15\n\tisb\n\tdsb" : : "r" (lo), "r" (hi));
+	}
+	mrg5_smp_mark('>');
+	mrg5_smp_mark(c);
+	asm volatile("mrrc p15, 1, %0, %1, c15" : "=r" (lo), "=r" (hi));
+	asm volatile("mrc p15, 0, %0, c1, c0, 1" : "=r" (a));
+	pr_info("mrg5-smp: cpu%u actlr %08x cpuectlr %08x%08x (smpen %u)\n",
+		smp_processor_id(), a, hi, lo, (lo >> 6) & 1);
+	preempt_enable();
+	return len;
+}
+
+static const struct file_operations mrg5_smpen_fops = {
+	.write	= mrg5_smpen_write,
+};
+
+static int mrg5_psci_init(void)
+{
+	u32 cores, arg, ret, ver, lo, hi, actlr;
+	unsigned long flags;
+
+	asm volatile("mrc p15, 1, %0, c9, c0, 2" : "=r" (cores));
+	cores = ((cores >> 24) & 3) + 1;
+	arg = cores | 0x3000100u;
+
+	local_irq_save(flags);
+	asm volatile(
+		".arch_extension sec\n\t"
+		"mov	r0, %[fid]\n\t"
+		"mov	r1, %[arg]\n\t"
+		"mov	r2, #0\n\t"
+		"mov	r3, #0\n\t"
+		"smc	#0\n\t"
+		"mov	%[ret], r0\n\t"
+		: [ret] "=r" (ret)
+		: [fid] "r" (0x83000000u), [arg] "r" (arg)
+		: "r0", "r1", "r2", "r3", "memory", "cc");
+	asm volatile(
+		".arch_extension sec\n\t"
+		"mov	r0, %[fid]\n\t"
+		"mov	r1, #0\n\t"
+		"mov	r2, #0\n\t"
+		"mov	r3, #0\n\t"
+		"smc	#0\n\t"
+		"mov	%[ver], r0\n\t"
+		: [ver] "=r" (ver)
+		: [fid] "r" (0x84000000u)
+		: "r0", "r1", "r2", "r3", "memory", "cc");
+	local_irq_restore(flags);
+
+	asm volatile("mrrc p15, 1, %0, %1, c15" : "=r" (lo), "=r" (hi));
