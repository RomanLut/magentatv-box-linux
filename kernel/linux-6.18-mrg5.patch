+static void mrg5_mai_mute(struct mrg5_hdmi *m, bool on)
+{
+	u32 v = mai_rd(m, MAI_FMT);
+
+	mai_wr(m, MAI_FMT, on ? (v | BIT(21)) : (v & ~BIT(21)));
+}
+
+static void mrg5_mai_set_format(struct mrg5_hdmi *m)
+{
+	u32 v;
+
+	v = mai_rd(m, MAI_RATE);
+	v = (v & ~0x00ff0000u) | 0x00820000u;
+	v &= ~0x1f000000u;
+	v = (v & ~0x0000ff00u) | 0x00000900u;
+	mai_wr(m, MAI_RATE, v);
+
+	mai_wr(m, MAI_FMT, mai_rd(m, MAI_FMT) & ~0x00100000u);
+	mai_wr(m, MAI_FMT, mai_rd(m, MAI_FMT) | BIT(2));
+
+	v = mai_rd(m, MAI_FMT);
+	v |= BIT(2);
+	v |= BIT(3);
+	v &= ~BIT(1);
+	mai_wr(m, MAI_FMT, v);
+
+	mai_wr(m, MAI_CSTAT_A, 0x02000004);
+	mai_wr(m, MAI_CSTAT_B, 0x00000001);
+
+	mai_wr(m, MAI_FMT, mai_rd(m, MAI_FMT) & ~BIT(2));
+}
+
+static void mrg5_mai_enable(struct mrg5_hdmi *m, unsigned int nch)
+{
+	unsigned int i, pairs = (MAI_END_BOUND - MAI_CH0) / 4;
+	u32 v;
+
+	v = mai_rd(m, MAI_ENABLE);
+	v = (v & ~4u) | 4u;
+	v = (v & ~3u) | (nch > 1 ? 1u : 0u);
+	mai_wr(m, MAI_ENABLE, v);
+
+	for (i = 0; i < nch; i++)
+		mai_wr(m, MAI_CH0 + 4 * i, mai_rd(m, MAI_CH0 + 4 * i) | BIT(13));
+	for (i = 0; i < nch; i++)
+		mai_wr(m, MAI_CH0 + 4 * i, mai_rd(m, MAI_CH0 + 4 * i) & ~BIT(13));
+	for (i = nch; i < pairs; i++)
+		mai_wr(m, MAI_CH0 + 4 * i, mai_rd(m, MAI_CH0 + 4 * i) & ~BIT(31));
+	for (i = 0; i < nch; i++)
+		mai_wr(m, MAI_CH0 + 4 * i, mai_rd(m, MAI_CH0 + 4 * i) | BIT(31));
+}
+
+static void mrg5_apply_volume(struct mrg5_hdmi *m)
+{
+	u32 coef = (MRG5_COEF_UNITY * min(m->volume, MRG5_VOL_MAX)) / MRG5_VOL_MAX;
+
+	aio_wr(m, 0x4800, coef);       aio_wr(m, 0x4e00, coef);
+	aio_wr(m, 0x4804, 0x00000000); aio_wr(m, 0x4e04, 0x00000000);
+	aio_wr(m, 0x4808, 0x00000000); aio_wr(m, 0x4e08, 0x00000000);
+	aio_wr(m, 0x480c, coef);       aio_wr(m, 0x4e0c, coef);
+}
+
+static void mrg5_mixer_start(struct mrg5_hdmi *m)
+{
+	unsigned int i;
+
+	aio_wr(m, 0x4030, 0);
+	aio_wr(m, 0x4000, aio_rd(m, 0x4000) | BIT(31));
+	for (i = 0; i < 4; i++) {
+		aio_wr(m, 0x5400 + 4 * i, 0x00000a00);
+		aio_wr(m, 0x5a00 + 4 * i, 0x00000a00);
+	}
+	mrg5_apply_volume(m);
+	aio_wr(m, 0x4030, 0x00001000);
+
+	aio_wr(m, 0x4000, aio_rd(m, 0x4000) | BIT(25));
+	aio_wr(m, 0x6000, 0x00800000);
+	aio_wr(m, 0x6030, 0x00800000);
+	aio_wr(m, 0x4000, aio_rd(m, 0x4000) | BIT(0));
+}
+
+static u32 mrg5_acr_cts(struct mrg5_hdmi *m)
+{
+	u32 pixclk_hz, depth, mult_num = 1, mult_den = 1;
+	u64 tmds_hz, cts;
+
+	pixclk_hz = hdmi_rd(m, HDMI_PIXEL_CLOCK) * 50u;
+	depth = hdmi_rd(m, HDMI_COLOUR_DEPTH) & 0xf;
+
+	switch (depth) {
+	case 5: mult_num = 5; mult_den = 4; break;
+	case 6: mult_num = 3; mult_den = 2; break;
+	case 7: mult_num = 2; mult_den = 1; break;
+	default: break;
+	}
+
+	if (!pixclk_hz) {
+		dev_warn(m->dev, "pixel clock reads 0; falling back to 74.25 MHz\n");
+		pixclk_hz = 74250000u;
+	}
+
+	tmds_hz = (u64)pixclk_hz * mult_num;
+	do_div(tmds_hz, mult_den);
+
+	cts = tmds_hz * 6144;
+	do_div(cts, 128u * MRG5_RATE);
+
+	if ((u32)cts != m->acr_cts)
+		dev_info(m->dev, "ACR: pixel clock %u Hz, colour depth code %u -> TMDS %llu Hz, N 6144, CTS %llu\n",
+			 pixclk_hz, depth, tmds_hz, cts);
+	return (u32)cts;
+}
+
+static void mrg5_acr_program(struct mrg5_hdmi *m)
+{
+	u32 cts = mrg5_acr_cts(m);
+
+	m->acr_cts = cts;
+	hdmi_wr(m, HDMI_ACR_N, 6144);
+	hdmi_wr(m, HDMI_ACR_CTS0, cts);
+	hdmi_wr(m, HDMI_ACR_CTS1, cts);
+	hdmi_wr(m, HDMI_ACR_CTS2, 0x01000000u | cts);
+	hdmi_wr(m, HDMI_ACR_CTS3, 0x01000000u | cts);
+	hdmi_wr(m, HDMI_AUDIO_ENABLE, hdmi_rd(m, HDMI_AUDIO_ENABLE) | BIT(3));
+}
+
+static void mrg5_drift_fifo_reset(struct mrg5_hdmi *m)
+{
+	unsigned int i;
+
+	for (i = 0; i < 2; i++) {
+		hdmi_wr(m, HDMI_DRIFT_FIFO, hdmi_rd(m, HDMI_DRIFT_FIFO) & ~BIT(6));
+		udelay(50);
+		hdmi_wr(m, HDMI_DRIFT_FIFO, hdmi_rd(m, HDMI_DRIFT_FIFO) | BIT(6));
+		udelay(50);
+	}
+}
+
+static void mrg5_publish(struct mrg5_hdmi *m, u32 r_off, u32 r_gen)
+{
+	u32 sum = r_off + (MRG5_RING_BYTES - MRG5_FEED_GAP);
+	u32 w_off = sum % MRG5_RING_BYTES;
+	u32 w_gen = (sum >= MRG5_RING_BYTES) ? (r_gen ^ 1u) : r_gen;
+
+	aio_wr(m, CH_WRITE, (m->ring_base + w_off) | (w_gen << 31));
+}
+
+static void mrg5_fill(struct mrg5_hdmi *m, u32 off, u32 len)
+{
+	struct snd_pcm_substream *sub = m->sub;
+	struct snd_pcm_runtime *rt = sub ? sub->runtime : NULL;
+	u64 avail = 0;
+
+	if (rt && rt->dma_area && rt->control) {
+		u64 appl = (u64)READ_ONCE(rt->control->appl_ptr) * MRG5_FRAME_BYTES;
+
+		if (appl > m->taken)
+			avail = appl - m->taken;
+	}
+
+	while (len) {
+		u32 chunk = min(len, MRG5_RING_BYTES - off);
+
+		if (rt && rt->dma_area) {
+			u32 size = (u32)rt->dma_bytes;
+			u32 src = m->take_off;
+
+			chunk = min(chunk, size - src);
+			if (avail >= chunk) {
+				memcpy(m->ring + off, rt->dma_area + src, chunk);
+				avail -= chunk;
+			} else {
+				memset(m->ring + off, 0, chunk);
+				avail = 0;
+			}
+			src += chunk;
+			m->take_off = (src >= size) ? src - size : src;
+			m->taken += chunk;
+		} else {
+			memset(m->ring + off, 0, chunk);
+		}
+		m->fed += chunk;
+		off = (off + chunk) % MRG5_RING_BYTES;
+		len -= chunk;
+	}
+}
+
+static void mrg5_clear(struct mrg5_hdmi *m, u32 off, u32 len)
+{
+	while (len) {
+		u32 chunk = min(len, MRG5_RING_BYTES - off);
+
+		memset(m->ring + off, 0, chunk);
+		off = (off + chunk) % MRG5_RING_BYTES;
+		len -= chunk;
+	}
+}
+
+static enum hrtimer_restart mrg5_tick(struct hrtimer *t)
+{
+	struct mrg5_hdmi *m = container_of(t, struct mrg5_hdmi, timer);
+	struct snd_pcm_substream *elapsed = NULL;
+	unsigned long flags;
+	u32 raw, r_off, r_gen, newly;
+
+	spin_lock_irqsave(&m->lock, flags);
+
+	raw = aio_rd(m, CH_READ);
+	r_gen = raw >> 31;
+	r_off = (raw & 0x7fffffffu) - m->ring_base;
+	if (r_off >= MRG5_RING_BYTES)
+		r_off = m->prev_off;
+
+	newly = (r_off - m->prev_off) % MRG5_RING_BYTES;
+	if (newly) {
+		mrg5_fill(m, (m->prev_off + MRG5_LEAD) % MRG5_RING_BYTES, newly);
+		mrg5_clear(m, m->prev_off, newly);
+		m->prev_off = r_off;
+		if (newly > MRG5_LEAD)
+			dev_warn_ratelimited(m->dev, "feeder tick late: %u bytes consumed\n", newly);
+	}
+	mrg5_publish(m, r_off, r_gen);
+
+	if (!m->unmuted && m->fed >= MRG5_RING_BYTES) {
+		mrg5_drift_fifo_reset(m);
+		mrg5_mai_mute(m, m->muted);
+		m->unmuted = true;
+	}
+
+	if (m->sub && m->sub->runtime) {
+		u64 period = frames_to_bytes(m->sub->runtime, m->sub->runtime->period_size);
+
+		if (period && m->taken - m->last_elapsed >= period) {
+			m->last_elapsed += period;
+			elapsed = m->sub;
+		}
+	}
+	spin_unlock_irqrestore(&m->lock, flags);
+
+	if (elapsed)
+		snd_pcm_period_elapsed(elapsed);
+
+	hrtimer_forward_now(t, ns_to_ktime(MRG5_TICK_NS));
+	return HRTIMER_RESTART;
+}
+
+static const DECLARE_TLV_DB_LINEAR(mrg5_db_scale, TLV_DB_GAIN_MUTE, 0);
