diff -ruN a/drivers/clk/clk-mrg5-uart.c b/drivers/clk/clk-mrg5-uart.c
--- a/drivers/clk/clk-mrg5-uart.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/clk/clk-mrg5-uart.c	2026-10-03 00:12:23.428841901 +0200
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+
+#define CHAIN_ROOT "stb_sysctrl_uart_1"
+#define MAX_CHAIN 32
+
+static DEFINE_SPINLOCK(mrg5_uart_clk_lock);
+static struct device_node *chain[MAX_CHAIN];
+static int chain_len = -1;
+
+static void __init chain_add(struct device_node *np)
+{
+	struct of_phandle_iterator it;
+	int i;
+
+	for (i = 0; i < chain_len; i++)
+		if (chain[i] == np)
+			return;
+	if (chain_len >= MAX_CHAIN) {
+		pr_warn("mrg5-uart-clk: chain longer than %d nodes\n", MAX_CHAIN);
+		return;
+	}
+	chain[chain_len++] = np;
+	of_for_each_phandle(&it, i, np, "clocks", "#clock-cells", 0)
+		chain_add(it.node);
+}
+
+static void __init chain_build(void)
+{
+	struct device_node *np;
+
+	if (chain_len >= 0)
+		return;
+	chain_len = 0;
+	for_each_node_by_name(np, CHAIN_ROOT)
+		chain_add(np);
+	pr_info("mrg5-uart-clk: %d clock nodes behind %s\n", chain_len, CHAIN_ROOT);
+}
+
+static bool __init in_chain(struct device_node *np)
+{
+	int i;
+
+	chain_build();
+	for (i = 0; i < chain_len; i++)
+		if (chain[i] == np)
+			return true;
+	return false;
+}
+
+static void __init leave_as_mainline(struct device_node *np)
+{
+	if (of_device_is_compatible(np, "fixed-clock"))
+		of_fixed_clk_setup(np);
+}
+
+static void __iomem *__init map_reg(struct device_node *np)
+{
+	void __iomem *reg = of_iomap(np, 0);
+
+	if (!reg)
+		pr_err("mrg5-uart-clk: %pOFn: cannot map reg\n", np);
+	return reg;
+}
+
+static u32 __init prop_u32(struct device_node *np, const char *name, u32 def)
+{
+	u32 v;
+
+	return of_property_read_u32(np, name, &v) ? def : v;
+}
+
+
+struct ro_gate {
+	struct clk_hw hw;
+	void __iomem *reg;
+	u8 bit;
+	bool set_to_disable;
+};
+
+static unsigned long ro_gate_recalc(struct clk_hw *hw, unsigned long parent_rate)
+{
+	struct ro_gate *g = container_of(hw, struct ro_gate, hw);
+	bool bit = readl(g->reg) & BIT(g->bit);
+
+	return bit == g->set_to_disable ? 0 : parent_rate;
+}
+
+static int ro_gate_determine(struct clk_hw *hw, struct clk_rate_request *req)
+{
+	struct clk_hw *parent = clk_hw_get_parent(hw);
+	struct clk_rate_request preq;
+	int ret;
+
+	if (!parent)
+		return -EINVAL;
+	if (!(clk_hw_get_flags(hw) & CLK_SET_RATE_PARENT)) {
+		req->rate = clk_hw_get_rate(hw);
+		return 0;
+	}
+	clk_hw_forward_rate_request(hw, req, parent, &preq, req->rate);
+	ret = __clk_determine_rate(parent, &preq);
+	if (ret)
+		return ret;
+	req->best_parent_hw = parent;
+	req->best_parent_rate = preq.rate;
+	req->rate = preq.rate;
+	return 0;
+}
+
+static const struct clk_ops ro_gate_ops = {
+	.recalc_rate = ro_gate_recalc,
+	.determine_rate = ro_gate_determine,
+};
+
+static void __init mrg5_gate_setup(struct device_node *np)
+{
+	struct clk_init_data init = {};
+	const char *parent;
+	struct ro_gate *g;
+	int ret;
+
+	if (!in_chain(np)) {
+		leave_as_mainline(np);
+		return;
+	}
+	g = kzalloc(sizeof(*g), GFP_KERNEL);
+	if (!g)
+		return;
+	g->reg = map_reg(np);
+	if (!g->reg)
+		goto free;
+	g->bit = prop_u32(np, "bit-shift", 0);
+	g->set_to_disable = of_property_read_bool(np, "set-bit-to-disable");
+	parent = of_clk_get_parent_name(np, 0);
+	init.name = np->name;
+	init.ops = &ro_gate_ops;
+	init.parent_names = &parent;
+	init.num_parents = 1;
+	if (of_property_read_bool(np, "brcm,set-rate-parent"))
+		init.flags |= CLK_SET_RATE_PARENT;
+	g->hw.init = &init;
+	ret = clk_hw_register(NULL, &g->hw);
+	if (!ret)
+		ret = of_clk_add_hw_provider(np, of_clk_hw_simple_get, &g->hw);
+	if (!ret)
+		return;
+	pr_err("mrg5-uart-clk: %pOFn: %d\n", np, ret);
+	iounmap(g->reg);
+free:
+	kfree(g);
+}
+CLK_OF_DECLARE(mrg5_brcmstb_gate, "brcm,brcmstb-gate-clk", mrg5_gate_setup);
+
+
+static void __init mrg5_divider_setup(struct device_node *np)
+{
+	u32 mask = prop_u32(np, "bit-mask", 0xff);
+	unsigned long flags = CLK_DIVIDER_READ_ONLY;
+	void __iomem *reg;
+	struct clk_hw *hw;
+
+	if (!in_chain(np)) {
+		leave_as_mainline(np);
+		return;
+	}
+	reg = map_reg(np);
+	if (!reg)
+		return;
+	if (of_property_read_bool(np, "index-starts-at-one"))
+		flags |= CLK_DIVIDER_ONE_BASED;
+	hw = clk_hw_register_divider(NULL, np->name, of_clk_get_parent_name(np, 0), 0,
+				     reg, prop_u32(np, "bit-shift", 0), fls(mask), flags,
+				     &mrg5_uart_clk_lock);
+	if (IS_ERR(hw) || of_clk_add_hw_provider(np, of_clk_hw_simple_get, hw))
+		pr_err("mrg5-uart-clk: %pOFn: divider failed\n", np);
+}
+CLK_OF_DECLARE(mrg5_divider, "divider-clock", mrg5_divider_setup);
+
+
+static void __init mrg5_mux_setup(struct device_node *np)
+{
+	const char *parents[8];
+	u32 mask = prop_u32(np, "bit-mask", 0x3);
+	void __iomem *reg;
+	struct clk_hw *hw;
+	int i, n;
+
+	if (!in_chain(np)) {
+		leave_as_mainline(np);
+		return;
+	}
+	n = of_clk_get_parent_count(np);
+	if (n < 1 || n > ARRAY_SIZE(parents)) {
+		pr_err("mrg5-uart-clk: %pOFn: %d parents\n", np, n);
+		return;
+	}
+	for (i = 0; i < n; i++)
+		parents[i] = of_clk_get_parent_name(np, i);
+	reg = map_reg(np);
+	if (!reg)
+		return;
+	hw = clk_hw_register_mux(NULL, np->name, parents, n, 0, reg,
+				 prop_u32(np, "bit-shift", 0), fls(mask),
+				 CLK_MUX_ROUND_CLOSEST, &mrg5_uart_clk_lock);
+	if (IS_ERR(hw) || of_clk_add_hw_provider(np, of_clk_hw_simple_get, hw)) {
+		pr_err("mrg5-uart-clk: %pOFn: mux failed\n", np);
+		return;
+	}
+	pr_info("mrg5-uart-clk: %pOFn: %d inputs, now %lu Hz\n", np, n,
+		clk_hw_get_rate(hw));
+}
+CLK_OF_DECLARE(mrg5_mux, "brcm,mux-clock", mrg5_mux_setup);
