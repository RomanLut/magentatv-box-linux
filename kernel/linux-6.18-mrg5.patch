+	{ 0xf04e000cu, 0x0000000eu, 0x000001feu },
+	{ 0xf04e0010u, 0x0000000eu, 0x000001feu },
+	{ 0xf04e0018u, 0x000000c8u, 0x000003ffu },
+	{ 0xf04e0018u, 0x00000c00u, 0x00003c00u },
+	{ 0xf04e0050u, 0x00000000u, 0x000001feu },
+	{ 0xf04e0054u, 0x00000000u, 0x000001feu },
+	{ 0xf04e0058u, 0x00000000u, 0x000001feu },
+	{ 0xf04e005cu, 0x00000000u, 0x000001feu },
+	{ 0xf04e00d4u, 0x0000000au, 0x000001feu },
+	{ 0xf04e00dcu, 0x00000082u, 0x000003ffu },
+	{ 0xf04e00dcu, 0x00000800u, 0x00003c00u },
+	{ 0xf04e0318u, 0x00000000u, 0x00000002u },
+	{ 0xf04e0374u, 0x00000000u, 0x00000001u },
+	{ 0xf04e0374u, 0x00000000u, 0x00000002u },
+	{ 0xf04e0400u, 0x00000000u, 0x00000001u },
+	{ 0xf04e0400u, 0x00000000u, 0x00000002u },
