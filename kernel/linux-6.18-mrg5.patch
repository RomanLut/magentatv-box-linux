+static int mrg5_pcm_open(struct snd_pcm_substream *sub)
+{
+	sub->runtime->hw = mrg5_pcm_hw;
+	return snd_pcm_hw_constraint_integer(sub->runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+}
+
+static int mrg5_pcm_close(struct snd_pcm_substream *sub)
+{
+	return 0;
+}
+
+static int mrg5_pcm_prepare(struct snd_pcm_substream *sub)
+{
+	struct mrg5_hdmi *m = snd_pcm_substream_chip(sub);
+	unsigned long flags;
+
+	if (mrg5_acr_cts(m) != m->acr_cts)
+		mrg5_acr_program(m);
+
+	spin_lock_irqsave(&m->lock, flags);
+	m->taken = 0;
+	m->last_elapsed = 0;
+	m->take_off = 0;
+	spin_unlock_irqrestore(&m->lock, flags);
+	return 0;
+}
+
+static int mrg5_pcm_trigger(struct snd_pcm_substream *sub, int cmd)
+{
+	struct mrg5_hdmi *m = snd_pcm_substream_chip(sub);
+	unsigned long flags;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		spin_lock_irqsave(&m->lock, flags);
+		m->sub = sub;
+		spin_unlock_irqrestore(&m->lock, flags);
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		spin_lock_irqsave(&m->lock, flags);
+		m->sub = NULL;
+		spin_unlock_irqrestore(&m->lock, flags);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static snd_pcm_uframes_t mrg5_pcm_pointer(struct snd_pcm_substream *sub)
+{
+	struct mrg5_hdmi *m = snd_pcm_substream_chip(sub);
+	struct snd_pcm_runtime *rt = sub->runtime;
+	unsigned long flags;
+	u32 off;
+
+	spin_lock_irqsave(&m->lock, flags);
+	off = m->take_off;
+	spin_unlock_irqrestore(&m->lock, flags);
+
+	rt->delay = bytes_to_frames(rt, MRG5_LEAD);
+	return bytes_to_frames(rt, off);
+}
+
+static const struct snd_pcm_ops mrg5_pcm_ops = {
+	.open		= mrg5_pcm_open,
+	.close		= mrg5_pcm_close,
+	.prepare	= mrg5_pcm_prepare,
+	.trigger	= mrg5_pcm_trigger,
+	.pointer	= mrg5_pcm_pointer,
+};
+
+static void mrg5_path_up(struct mrg5_hdmi *m)
+{
+	unsigned int i;
+
+	mrg5_mai_mute(m, true);
+	mrg5_acr_program(m);
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_graph); i++)
+		aio_wr(m, mrg5_graph[i].off, mrg5_graph[i].val);
+	for (i = 0; i < ARRAY_SIZE(mrg5_mai_state); i++)
+		mai_wr(m, mrg5_mai_state[i].off, mrg5_mai_state[i].val);
+
+	mrg5_mai_mute(m, true);
+
+	mrg5_mixer_start(m);
+	mrg5_mai_set_format(m);
+	mrg5_mai_enable(m, 1);
+
+	memset(m->ring, 0, MRG5_RING_BYTES);
+	m->prev_off = 0;
+	m->fed = 0;
+	m->unmuted = false;
+
+	aio_wr(m, CH_CFG, 0x00010000);
+	aio_wr(m, CH_BASE, m->ring_base);
+	aio_wr(m, CH_LIMIT, m->ring_base + MRG5_RING_BYTES - 1);
+	aio_wr(m, CH_READ, m->ring_base);
+	aio_wr(m, CH_WRITE, m->ring_base);
+	aio_wr(m, CH_G1_WRITE, 0x80000000);
+	aio_wr(m, AIO_EN0, 0x81002821);
+	aio_wr(m, AIO_EN2, 0x00000000);
+	aio_wr(m, AIO_EN0, aio_rd(m, AIO_EN0) | 1u);
+	aio_wr(m, AIO_EN1, 1);
+
+	mrg5_publish(m, 0, 0);
+
+	dev_info(m->dev, "ring at %pad, %u bytes; EN0 %08x EN1 %08x read %08x write %08x\n",
+		 &m->ring_dma, MRG5_RING_BYTES, aio_rd(m, AIO_EN0), aio_rd(m, AIO_EN1),
+		 aio_rd(m, CH_READ), aio_rd(m, CH_WRITE));
+}
+
+static void mrg5_path_down(struct mrg5_hdmi *m)
+{
+	mrg5_mai_mute(m, true);
+	aio_wr(m, AIO_EN1, 0);
+	aio_wr(m, AIO_EN0, aio_rd(m, AIO_EN0) & ~1u);
+}
