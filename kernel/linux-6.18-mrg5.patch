+		V3D_CORE_READ(0, V3D_CLE_RFC) & 0xff, V3D_CORE_READ(0, V3D_CLE_BFC) & 0xff,
+		V3D_CORE_READ(0, V3D_CLE_CT1TILECT), V3D_CORE_READ(0, V3D_CLE_CT1CFG),
+		V3D_CORE_READ(0, V3D_CLE_PCS), bqba, bqea);
+	n = v3d33_dump_va(job, job->start, len, "  rcl ", rcl, sizeof(rcl));
