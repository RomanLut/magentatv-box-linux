+static int v3d_debugfs_sched(struct seq_file *m, void *unused)
+{
+	struct drm_debugfs_entry *entry = m->private;
+	struct drm_device *dev = entry->dev;
+	struct v3d_dev *v3d = to_v3d_dev(dev);
+	static const char *const names[] = {
+		"bin", "render", "tfu", "csd", "cache_clean", "cpu"
+	};
+	enum v3d_queue q;
+
+	for (q = 0; q < V3D_MAX_QUEUES; q++) {
+		struct drm_gpu_scheduler *sched = &v3d->queue[q].sched;
+		struct drm_sched_job *s_job;
+		unsigned int pending = 0;
+		int first_hw = -1, first_done = -1;
+
+		if (!sched->ready)
+			continue;
+		spin_lock(&sched->job_list_lock);
+		list_for_each_entry(s_job, &sched->pending_list, list) {
+			if (!pending++) {
+				struct dma_fence *parent = s_job->s_fence->parent;
+
+				first_hw = parent ? dma_fence_is_signaled(parent) : -1;
+				first_done = dma_fence_is_signaled(&s_job->s_fence->finished);
+			}
+		}
+		spin_unlock(&sched->job_list_lock);
+		seq_printf(m, "%-11s credits %d/%u pending %u (oldest: hw fence %d, finished %d) pause_submit %d active_job %s\n",
+			   q < ARRAY_SIZE(names) ? names[q] : "?",
+			   atomic_read(&sched->credit_count), sched->credit_limit,
+			   pending, first_hw, first_done, READ_ONCE(sched->pause_submit),
+			   READ_ONCE(v3d->queue[q].active_job) ? "yes" : "no");
+	}
+
+	return 0;
+}
