+		pr_err("mrg5-v3d: cannot map the BPCM\n");
+		return 0;
+	}
+	v = readl(bpcm + (V3D_BPCM_ZONE & 0xfffu));
+	pr_info("mrg5-v3d: bpcm zone before %08x\n", v);
+	writel(V3D_BPCM_PWR_UP, bpcm + (V3D_BPCM_ZONE & 0xfffu));
+	for (i = 0; i < 1000; i++) {
+		v = readl(bpcm + (V3D_BPCM_ZONE & 0xfffu));
+		if ((v & V3D_BPCM_STATE_MASK) == V3D_BPCM_STATE_ON)
+			break;
+		udelay(10);
+	}
+	iounmap(bpcm);
+	if ((v & V3D_BPCM_STATE_MASK) != V3D_BPCM_STATE_ON) {
+		pr_err("mrg5-v3d: BPCM did not come up (%08x); leaving V3D down\n", v);
+		return 0;
+	}
+	pr_info("mrg5-v3d: bpcm zone %08x after %d poll(s)\n", v, i + 1);
+
+	hub = ioremap(V3D_HUB_BASE, 0x1000);
+	core = ioremap(V3D_CORE0_BASE, 0x1000);
+	if (hub && core)
+		pr_info("mrg5-v3d: hub ident %08x %08x, core0 ident %08x %08x\n",
+			readl(hub + 0x08), readl(hub + 0x0c),
+			readl(core + 0x00), readl(core + 0x04));
+	if (hub)
+		iounmap(hub);
+	if (core)
+		iounmap(core);
+	return 0;
+}
+
+arch_initcall(mrg5_v3d_power);
