+	u32 hv = ((nl << 16) & 0x0fff0000u) | (MRG5_WIDTH & 0x1fffu);
+	u32 trig_lo = ((MRG5_CFG_9A0 << 15) & 0x38000u) | 3u;
+	u32 trig_hi = ((MRG5_CFG_9A0 << 15) & 0x38000u) |
+		(MRG5_INTERLACED ? (((MRG5_V_TOTAL + 1) >> 1) + 3) : 0u);
+
+#define WR(r, v)	do { w[n++] = MRG5_RDC_OP_WR; w[n++] = (r); w[n++] = (v); } while (0)
+#define RMW(r, a, o)	do {						\
+		w[n++] = MRG5_RDC_OP_AND; w[n++] = (a);			\
+		w[n++] = MRG5_RDC_OP_OR;  w[n++] = (o);			\
+		w[n++] = MRG5_RDC_OP_RD;  w[n++] = (r);			\
+		w[n++] = MRG5_RDC_OP_AND_VAR;				\
+		w[n++] = MRG5_RDC_OP_OR_VAR;				\
+		w[n++] = MRG5_RDC_OP_WB;  w[n++] = (r);			\
+	} while (0)
+#define BURST(base, tab, cnt)	do {					\
+		w[n++] = MRG5_RDC_OP_BURST | ((cnt) - 1);		\
+		w[n++] = (base);					\
+		for (i = 0; i < (cnt); i++)				\
+			w[n++] = (tab)[i];				\
+	} while (0)
+#define IT_TIMING()	do {						\
+		BURST(MRG5_IT(0x0008u), mrg5_it_table, 17);		\
+		WR(MRG5_IT(0x02b4u), vlines);				\
+		WR(MRG5_IT(0x02c0u), vend);				\
+		WR(MRG5_IT(0x006cu), 0x60u);				\
+	} while (0)
+
+	WR(MRG5_DVI_MUX, 4);
+
+	WR(0xf06e7514u, 1); WR(0xf06e751cu, 1);
+	WR(0xf06e7524u, 1); WR(0xf06e7520u, 1);
+	WR(0xf06e7514u, 0); WR(0xf06e751cu, 0);
+	WR(0xf06e7524u, 0); WR(0xf06e7520u, 0);
+
+	WR(0xf06fa884u, MRG5_RM_W2);
+	WR(0xf06fa888u, (MRG5_RM_W3 << 8) | MRG5_RM_W8);
+	WR(0xf06fa898u, MRG5_RM_W4);
+	WR(0xf06fa89cu, ((MRG5_RM_W9 << 24) & 0x3000000u) | 8u);
+	WR(0xf06fa828u, (MRG5_RM_W10 << 16) | (MRG5_RM_W11 << 8));
+	WR(0xf06fa834u, 1);
+
+	RMW(0xf06fa81cu, 0xffffc11fu, 0x00002060u);
+	RMW(0xf06fa820u, 0xf000dfffu, 0x008a2000u);
+	RMW(0xf06fa810u, 0xfff0ffffu, MRG5_RM_W14 << 16);
+	RMW(0xf06fa814u, 0xfff00000u, 0x000865d8u);
+	WR(0xf06fa850u, 0x30000000u);
+	RMW(0xf06fa854u, 0xf0000000u, 0x00000000u);
+	WR(0xf06fa85cu, 0x0a8fa8f5u);
+	WR(0xf06fa89cu, 0x02000040u);
+	RMW(0xf06fa800u, 0xffffffcfu, 0x00000000u);
+	RMW(0xf06fa800u, 0xffffffcfu, 0x00000030u);
+
+	BURST(0xf06e618cu, mrg5_dtram, 64);
+
+	WR(0xf06e6180u, 0x0000000bu);
+	WR(0xf06e6010u, 0x00000249u);
+	WR(0xf06e6014u, 0x000001d9u);
+	WR(0xf06e6018u, 0x00000003u);
+	WR(0xf06e601cu, 0x00000040u);
+	WR(0xf06e6020u, hv);
+	WR(0xf06e602cu, trig_lo);
+	WR(0xf06e6030u, trig_hi);
+	WR(0xf06e60f0u, vlines);
+	WR(0xf06e60fcu, vend);
+	WR(0xf06e6a0cu, 0);
+	WR(0xf06e6c00u, 0);
+	WR(0xf06e6a10u, 0);
+	WR(0xf06e6900u, ((MRG5_WIDTH << 13) & 0x01ffe000u) | 0x885u | MRG5_6900_CS);
+	WR(MRG5_DVI_SRC, MRG5_CMP_ID & 7u);
+	WR(MRG5_DVI_MUX, 0);
+
+	WR((0x3c1b9d0fu + MRG5_IT_ID) << 2, 4);
+	WR(MRG5_IT(0x0004u), MRG5_IT_CTRL_VF);
+	IT_TIMING();
+	WR(MRG5_IT(0x004cu), hv);
+	w[n++] = MRG5_RDC_OP_BURST | 1u;
+	w[n++] = MRG5_IT(0x0058u);
+	w[n++] = trig_lo;
+	w[n++] = (trig_hi & 0x3fffu) | ((MRG5_CFG_9A0 << 15) & 0x38000u) |
+		 (MRG5_CFG_9A0 != 1 ? 0x40000u : 0u);
+	BURST(MRG5_IT(0x0400u), mrg5_analog, 256);
+	BURST(0xf06e2404u, mrg5_it_rm, 5);
+	WR((0x3c1b9c03u + MRG5_IT_ID) << 2, MRG5_IT_ID & 3u);
+	WR((0x3c1b9d0fu + MRG5_IT_ID) << 2, MRG5_CMP_ID & 7u);
+	WR(MRG5_SWITCH_DONE, 1);
+
+	WR(MRG5_IT(0x0004u), MRG5_IT_CTRL);
+	WR(0xf06e6008u, MRG5_DTG_CTRL);
+	IT_TIMING();
+
+	WR(MRG5_IT(0x02b4u), vlines);
+	WR(MRG5_IT(0x02c0u), vend);
+	WR(0xf06e6008u, MRG5_DTG_CTRL);
+	WR(MRG5_IT(0x0004u), MRG5_IT_CTRL);
+
+	WR(0xf06e2400u, 0x840u);
+	RMW(0xf06fa880u, 0xffff0000u, 0x00000840u);
+
+#undef IT_TIMING
+#undef BURST
+#undef WR
+#undef RMW
+	return n;
+}
+
+#define MRG5_HDMI_E4		0xf06fa0e4u
+
+static void mrg5_p50_hdmi_fmt(u32 *v)
+{
+	const u16 *h = mrg5_hdmi_fmt;
+	u32 pr = 1, div = 1;
+	u32 w18 = h[0x18 / 2] | ((u32)h[0x1a / 2] << 16);
+	u32 w1c = h[0x1c / 2] | ((u32)h[0x1e / 2] << 16);
+
+	v[0] = ((w1c << 15) & 0xffffu) | ((w18 << 14) & 0x4000u) |
+	       ((pr * h[0x14 / 2] / div) & 0x3fffu) |
+	       (((pr * h[0x20 / 2] / div) << 16) & 0x1fff0000u);
+	v[1] = (((pr * h[0x24 / 2] / div) << 16) & 0x07ff0000u) |
+	       ((pr * h[0x22 / 2] / div) & 0x7ffu);
+	v[2] = (((u32)h[0x2a / 2] << 24) & 0x1f000000u) |
+	       (((u32)h[0x28 / 2] << 16) & 0x7f0000u) | (h[0x26 / 2] & 0x1fffu);
+	v[3] = (((u32)h[0x2e / 2] << 16) & 0x3fff0000u) | (h[0x2c / 2] & 0x1ffu);
+	v[4] = (((u32)h[0x34 / 2] << 24) & 0x1f000000u) |
+	       (((u32)h[0x32 / 2] << 16) & 0x7f0000u) | (h[0x30 / 2] & 0x1fffu);
+	v[5] = (((u32)h[0x38 / 2] << 16) & 0x3fff0000u) | (h[0x36 / 2] & 0x1ffu);
+}
+
+#endif
diff -ruN a/arch/arm/mach-bcm/mrg5-p50.c b/arch/arm/mach-bcm/mrg5-p50.c
--- a/arch/arm/mach-bcm/mrg5-p50.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/arm/mach-bcm/mrg5-p50.c	2026-10-03 00:12:23.317246911 +0200
@@ -0,0 +1,253 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/mrg5-display.h>
+#include <linux/types.h>
+
+#include "mrg5-avf-37.h"
+#include "mrg5-p50-rul.h"
+#include "mrg5-p50-gfx.h"
+
+#define P50_SRR_PHYS		0xbd700000u
+#define P50_SRR_VIRT		0xf2000000u
+
+#define P50_RUL_OFF		0x00010000u
+#define P50_NOP_OFF		0x00011000u
+#define P50_GFX_OFF		0x00012000u
+
+#define P50_FB_OFF		0x00017000u
+#define P50_FB_PITCH		(1920u * 4u)
+
+#define P50_GFX_CTRL_REG	0xf0641010u
+#define P50_GFX_CTRL		0x2u
+
+static inline u32 p50_rd(u32 a)
+{
+	return readl((void __iomem *)a);
+}
+
+static inline void p50_wr(u32 a, u32 v)
+{
+	writel(v, (void __iomem *)a);
+}
+
+#define RDC_SLOT_LIST		0xf0604000u
+#define RDC_SLOT_LEN		0xf0604008u
+#define RDC_SLOT_CFG		0xf0604010u
+#define RDC_SLOT_EXEC		0xf0604020u
+#define RDC_ARM_BASE		0xf0605000u
+#define RDC_CFG_ARM		0x04000000u
+#define RDC_CFG_KEEP		0xfbff7fe0u
+
+static void __init p50_slots_setlist(const u32 *offs, unsigned int count,
+				     u32 phys, u32 nwords)
+{
+	u32 trigger = p50_rd(RDC_SLOT_CFG + offs[0]) & 0x1fu;
+	unsigned int i;
+
+	p50_wr(RDC_ARM_BASE + 8u * trigger, 0);
+	for (i = 0; i < count; i++) {
+		p50_wr(RDC_SLOT_LIST + offs[i], phys);
+		p50_wr(RDC_SLOT_LEN + offs[i], (nwords - 1) & 0x7fffu);
+	}
+	p50_wr(RDC_ARM_BASE + 8u * trigger, 1);
+}
+
+#define RDC_CFG_ACTIVE		0x02000000u
+
+static void __init p50_slot_disable(u32 off)
+{
+	u32 v = p50_rd(RDC_SLOT_CFG + off);
+
+	if (v & RDC_CFG_ACTIVE)
+		p50_wr(RDC_SLOT_CFG + off, v & ~RDC_CFG_ARM);
+}
+
+static void __init p50_slot_execute_on_trigger(u32 off, u32 phys, u32 nwords)
+{
+	u32 cfg = p50_rd(RDC_SLOT_CFG + off);
+	u32 trigger = cfg & 0x1fu;
+
+	p50_wr(RDC_ARM_BASE + 8u * trigger, 0);
+	p50_wr(RDC_SLOT_LIST + off, phys);
+	p50_wr(RDC_SLOT_CFG + off,
+	       (cfg & RDC_CFG_KEEP) | trigger | RDC_CFG_ARM | 0x02000000u);
+	p50_wr(RDC_SLOT_LEN + off, (nwords - 1) & 0x7fffu);
+	p50_wr(RDC_ARM_BASE + 8u * trigger, 1);
+}
+
+static u32 __iomem *p50_gfx_list;
+static unsigned int p50_src_word;
+
+bool mrg5_p50_ready(void)
+{
+	return p50_gfx_list != NULL;
+}
+
+void mrg5_p50_set_scanout(u32 phys)
+{
+	if (p50_gfx_list)
+		writel(phys, p50_gfx_list + p50_src_word);
+}
+
+u32 mrg5_p50_console_scanout(void)
+{
+	return P50_SRR_PHYS + P50_FB_OFF;
+}
+
+static unsigned int __init p50_build_gfx(u32 *w)
+{
+	unsigned int i, j, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(mrg5_gfx_list); i++) {
+		const struct mrg5_gfx_entry *e = &mrg5_gfx_list[i];
+
+		if (e->kind == 2) {
+			w[n++] = MRG5_RDC_OP_WR;
+			w[n++] = e->reg;
+			p50_src_word = n;
+			w[n++] = P50_SRR_PHYS + P50_FB_OFF;
+			continue;
+		}
+		if (e->kind == 1) {
+			w[n++] = MRG5_RDC_OP_BURST | (e->count - 1);
+			w[n++] = e->reg;
+			for (j = 0; j < e->count; j++)
+				w[n++] = e->vals[j];
+			continue;
+		}
+		w[n++] = MRG5_RDC_OP_WR;
+		w[n++] = e->reg;
+		if (e->reg == MRG5_GFX_PITCH_REG)
+			w[n++] = P50_FB_PITCH;
+		else if (e->reg == P50_GFX_CTRL_REG)
+			w[n++] = P50_GFX_CTRL;
+		else
+			w[n++] = e->vals[0];
+	}
+	return n;
+}
+
+static void __init p50_slot_execute(u32 off, u32 phys, u32 nwords)
+{
+	u32 cfg = p50_rd(RDC_SLOT_CFG + off);
+	u32 trigger = cfg & 0x1fu;
+
+	p50_wr(RDC_SLOT_LIST + off, phys);
+	if (!(cfg & RDC_CFG_ARM))
+		cfg &= ~(0x02fc0000u | 0x00030000u);
+	p50_wr(RDC_SLOT_CFG + off, (cfg & RDC_CFG_KEEP) | trigger | RDC_CFG_ARM);
+	p50_wr(RDC_SLOT_LEN + off, (nwords - 1) & 0x7fffu);
+	p50_wr(RDC_SLOT_EXEC + off, 1);
+}
+
+static void __init p50_enable_triggers(void)
+{
+	u32 v;
+
+	v = p50_rd(MRG5_IT(0x0058u)) & ~0x4000u;
+	p50_wr(MRG5_IT(0x0058u), v | 0x4000u);
+
+	v = p50_rd(MRG5_IT(0x005cu)) & ~0x4000u;
+	if (MRG5_INTERLACED || MRG5_CFG_9A0 != 1)
+		v |= 0x4000u;
+	p50_wr(MRG5_IT(0x005cu), v);
+
+	p50_wr(0xf06e7474u + 4u * MRG5_CMP_ID, 0);
+}
+
+#define P50_HDMI_DRIFT		0xf06fa074u
+
+static void __init p50_drift_recentre(void)
+{
+	u32 v = p50_rd(P50_HDMI_DRIFT) & 0x0007ffbfu;
+
+	p50_wr(P50_HDMI_DRIFT, v);
+	p50_wr(P50_HDMI_DRIFT, v | 0x40u);
+}
+
+static void __init p50_hdmi_enable(void)
+{
+	u32 v[6];
+	unsigned int i;
+
+	mrg5_p50_hdmi_fmt(v);
+	for (i = 0; i < 6; i++)
+		p50_wr(MRG5_HDMI_E4 + 4 * i, v[i]);
+
+	p50_drift_recentre();
+	udelay(20 * 50);
+	p50_drift_recentre();
+	for (i = 0; i < 10 && !(p50_rd(P50_HDMI_DRIFT) & 0x4000u); i++)
+		mdelay(1);
+	v[0] = p50_rd(P50_HDMI_DRIFT);
+	p50_wr(P50_HDMI_DRIFT, (v[0] & ~0x2002u) | 0x2000u);
+}
+
+static u32 p50_words[704] __initdata;
+
+static int __init mrg5_p50_init(void)
+{
+	static const u32 both[] = { 0x00u, 0x40u };
+	u32 __iomem *w = (u32 __iomem *)(P50_SRR_VIRT + P50_RUL_OFF);
+	u32 __iomem *nop = (u32 __iomem *)(P50_SRR_VIRT + P50_NOP_OFF);
+	u32 __iomem *gfx = (u32 __iomem *)(P50_SRR_VIRT + P50_GFX_OFF);
+	u32 gfx_phys = P50_SRR_PHYS + P50_GFX_OFF;
+	u32 phys = P50_SRR_PHYS + P50_RUL_OFF;
+	u32 nop_phys = P50_SRR_PHYS + P50_NOP_OFF;
+	unsigned int i, n, t;
+	u32 a, b;
+
+	for (t = 0, b = p50_rd(RDC_SLOT_LIST); t < 40; t++) {
+		mdelay(50);
+		a = b;
+		b = p50_rd(RDC_SLOT_LIST);
+		if (a == b)
+			break;
+	}
+
+	n = mrg5_p50_build(p50_words);
+	for (i = 0; i < n; i++)
+		writel_relaxed(p50_words[i], w + i);
+	writel_relaxed(MRG5_RDC_OP_WR, nop + 0);
+	writel_relaxed(MRG5_NOP_REG, nop + 1);
+	writel_relaxed(MRG5_NOP_VAL, nop + 2);
+	wmb();
+
+	p50_wr(MRG5_SWITCH_DONE, 0);
+	p50_slots_setlist(&both[0], 1, phys, n);
+	p50_slot_execute(0x00u, phys, n);
+
+	for (t = 0; t < 2000 && !p50_rd(MRG5_SWITCH_DONE); t++)
+		udelay(100);
+	pr_info("mrg5-p50: frame %u words at %08x, done=%08x after %u us\n",
+		n, phys, p50_rd(MRG5_SWITCH_DONE), t * 100);
+	if (!p50_rd(MRG5_SWITCH_DONE))
+		return 0;
+
+	p50_wr(MRG5_SWITCH_DONE, 0);
+	p50_slots_setlist(&both[1], 1, nop_phys, 3);
+	p50_enable_triggers();
+	p50_hdmi_enable();
+
+	n = p50_build_gfx(p50_words);
+	for (i = 0; i < n; i++)
+		writel_relaxed(p50_words[i], gfx + i);
+	wmb();
+	for (t = 0; t < 20; t++) {
+		p50_slots_setlist(&both[0], 1, gfx_phys, n);
+		mdelay(20);
+		if (p50_rd(RDC_SLOT_LIST) == gfx_phys)
+			break;
+	}
+	pr_info("mrg5-p50: graphics list %u words at %08x\n", n, gfx_phys);
+	p50_gfx_list = gfx;
+
+	pr_info("mrg5-p50: switched, f06e004c=%08x f06e0058=%08x f06fa0ec=%08x f06fa168=%08x\n",
+		p50_rd(0xf06e004c), p50_rd(0xf06e0058), p50_rd(0xf06fa0ec),
+		p50_rd(0xf06fa168));
+	return 0;
+}
+late_initcall_sync(mrg5_p50_init);
