  * Userspace provides the register setup for the TFU, which we don't
  * need to validate since the TFU is behind the MMU.
  */
+static bool v3d33_tfu_addr_ok(struct v3d_tfu_job *job, u32 addr, bool output)
+{
+	unsigned int i;
+
+	for (i = 0; i < job->base.bo_count; i++) {
+		struct v3d_bo *bo = to_v3d_bo(job->base.bo[i]);
+		u64 start = (u64)bo->node.start << V3D_MMU_PAGE_SHIFT;
+
+		if (!bo->identity || addr < start || addr >= start + bo->base.base.size)
+			continue;
+		return !output || bo->contig_phys;
+	}
+	return false;
+}
+
+static int v3d33_tfu_check(struct v3d_dev *v3d, struct v3d_tfu_job *job,
+			   struct drm_v3d_submit_tfu *args)
+{
+	if (!v3d->contig_pool) {
+		DRM_DEBUG("TFU on V3D 3.3 needs the reserved GPU region\n");
+		return -ENODEV;
+	}
+	if (!v3d33_tfu_addr_ok(job, args->iia, false) ||
+	    (args->ica && !v3d33_tfu_addr_ok(job, args->ica, false)) ||
+	    (args->iua && !v3d33_tfu_addr_ok(job, args->iua, false)) ||
+	    !v3d33_tfu_addr_ok(job, args->ioa & ~0x3fu, true)) {
+		dev_err(v3d->drm.dev,
+			"TFU job refused: iia %08x ica %08x iua %08x ioa %08x not in its buffers\n",
+			args->iia, args->ica, args->iua, args->ioa);
+		return -EINVAL;
+	}
+	return 0;
+}
