#!/bin/bash
# X session for the MRG5: minimal window manager plus a terminal.
# /etc/X11/xinit/xinitrc starts a desktop environment when one is installed;
# this keeps the session explicit and small.
xrdb -merge /etc/X11/Xresources/x11-common 2>/dev/null
xset s off -dpms 2>/dev/null
twm &
exec xterm -fa Monospace -fs 14 -bg black -fg white -geometry 100x30+20+20
