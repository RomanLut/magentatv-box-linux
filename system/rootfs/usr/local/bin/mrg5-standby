#!/usr/bin/env python3
"""Soft standby (checks/41, "Soft standby"): the box stays on, but quiet.

    mrg5-standby on | off | toggle | status

on:  ends the program started from the TV launcher (SIGTERM to its process tree, as
     Alt+F4 would; the launcher comes back behind it), switches the HDMI output and the audio
     ring off (the HDMI audio driver's standby switch, since zImage-smp5z: TMDS outputs off, so
     the TV sees no signal, and no 5 ms feeder timer; older kernels: X DPMS off and the
     console framebuffer cleared - a black picture - since our KMS driver then shows that
     buffer, which held the console cursor),
     spins the internal disk down (hdparm -y; a disk in use - the system or /DATA - gets a
     5-minute timer instead), with "cpu=low" in /etc/mrg5-standby.conf (the default; the launcher's settings
     switch it) sets the CPU frequency to the lowest (cpufreq governor powersave, AVS
     firmware) and takes cores 1-3 offline ("cpu=normal" leaves the CPU alone), and turns
     the middle front LED red.
     Then it waits for any key press (remote, keyboard, game pad, mouse button) on any
     input device, including devices that appear later (the remote reconnects on a key
     press), and wakes the box. The devices are grabbed (EVIOCGRAB) meanwhile, so the key
     that wakes the box reaches no program (it would otherwise start the selected tile).
off: the reverse: cores online, governor performance, the disk's normal timer (none for the
     system's disk, 20 minutes for an HDD with only data), screen on, middle LED green.

The remote's Power key toggles it (rcu-home-exit). A real power-off is not offered: nothing
could switch the box on again (checks/41, "Remote power button").
"""
import fcntl
import glob
import os
import select
import signal
import struct
import subprocess
import sys
import time

STATE = "/run/mrg5-standby"
LOCK = "/run/mrg5-standby.lock"
MICROP = "/usr/local/bin/microp"
X_ENV = dict(os.environ, DISPLAY=":0")
EV = struct.Struct("llHHi")                   # struct input_event on 32-bit ARM
EV_KEY = 1
EVIOCGRAB = 0x40044590                        # _IOW('E', 0x90, int)
FB = "/sys/class/graphics/fb0"
HDMI_STANDBY = "/sys/devices/platform/mrg5-hdmi-audio/standby"
TEMP = "/sys/class/thermal/thermal_zone0/temp"
CONF = "/etc/mrg5-standby.conf"
ROOT_DISK_TIMER = "60"                         # hdparm -S 60 = 5 min idle, for a disk in use
IDLE_TIMER = "240"                             # -S 240 = 20 min: a data-only HDD outside standby


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def run(*cmd, env=None):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=15, env=env)
    except (OSError, subprocess.SubprocessError) as e:
        log("failed:", " ".join(cmd), e)
        return None


def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(value)
        return True
    except OSError as e:
        log("cannot write", path, e)
        return False


def children():
    """pid -> list of child pids, from /proc."""
    kids = {}
    for p in os.listdir("/proc"):
        if p.isdigit():
            try:
                with open("/proc/%s/stat" % p) as f:
                    ppid = int(f.read().rsplit(")", 1)[1].split()[1])
                kids.setdefault(ppid, []).append(int(p))
            except (OSError, ValueError, IndexError):
                pass
    return kids


def launcher_pid():
    for p in os.listdir("/proc"):
        if p.isdigit():
            try:
                with open("/proc/%s/cmdline" % p, "rb") as f:
                    if b"mrg5-launcher/launcher.py" in f.read():
                        return int(p)
            except OSError:
                pass
    return None


def end_program():
    """SIGTERM the process trees the launcher started; SIGKILL what is left after 8 s."""
    lp = launcher_pid()
    if lp is None:
        return
    kids = children()
    tree, todo = [], list(kids.get(lp, []))
    while todo:
        p = todo.pop()
        tree.append(p)
        todo.extend(kids.get(p, []))
    if not tree:
        return
    log("ending the launcher's program:", tree)
    for p in tree:
        try:
            os.kill(p, signal.SIGTERM)
        except ProcessLookupError:
            pass
    for _ in range(80):
        if not any(os.path.exists("/proc/%d" % p) for p in tree):
            return
        time.sleep(0.1)
    for p in tree:
        try:
            os.kill(p, signal.SIGKILL)
        except ProcessLookupError:
            pass


def sata_disks():
    """(device, in use) for disks on the SATA port; in use = a filesystem on it is mounted
    (the system, or /DATA from mrg5-storage), so it only gets an idle timer."""
    out = []
    for d in glob.glob("/sys/block/sd*"):
        if "/ata" in os.path.realpath(d):
            dev = "/dev/" + os.path.basename(d)
            r = run("lsblk", "-n", "-o", "MOUNTPOINT", dev)
            out.append((dev, bool(r and r.stdout.split())))
    return out


def clear_console_fb():
    try:
        with open(FB + "/stride") as f:
            stride = int(f.read())
        with open(FB + "/virtual_size") as f:
            height = int(f.read().split(",")[1])
        with open("/dev/fb0", "wb") as f:
            f.write(bytes(stride * height))
    except (OSError, ValueError, IndexError) as e:
        log("console framebuffer not cleared:", e)


def cpu_low():
    """/etc/mrg5-standby.conf: cpu=low (default) or cpu=normal."""
    try:
        with open(CONF) as f:
            return not any(l.strip().replace(" ", "") == "cpu=normal" for l in f)
    except OSError:
        return True


def temperature():
    try:
        with open(TEMP) as f:
            return "%.1f C" % (int(f.read()) / 1000)
    except (OSError, ValueError):
        return "?"


def cpus(on):
    for c in sorted(glob.glob("/sys/devices/system/cpu/cpu[1-9]*/online")):
        write(c, "1" if on else "0")
    for g in glob.glob("/sys/devices/system/cpu/cpufreq/policy*/scaling_governor"):
        write(g, "performance" if on else "powersave")


def standby_on():
    end_program()
    if not (os.path.exists(HDMI_STANDBY) and write(HDMI_STANDBY, "1")):
        run("xset", "dpms", "force", "off", env=X_ENV)
        time.sleep(0.5)
        clear_console_fb()
    for dev, in_use in sata_disks():
        if in_use:
            run("hdparm", "-S", ROOT_DISK_TIMER, dev)
        else:
            run("hdparm", "-y", dev)
    if cpu_low():
        cpus(False)
    if os.path.exists(MICROP):
        run(MICROP, "set", "middle", "green", "off", "middle", "yellow", "off", "middle", "red", "on")
    write(STATE, "%d\n" % os.getpid())
    log("standby on, SoC", temperature(), "CPU", "low" if cpu_low() else "normal")


def root_disk():
    r = run("findmnt", "-n", "-o", "SOURCE", "/")
    src = r.stdout.strip() if r else ""
    r = run("lsblk", "-n", "-o", "PKNAME", src) if src else None
    return "/dev/" + r.stdout.split()[0] if r and r.stdout.split() else src


def standby_off():
    cpus(True)
    root = root_disk()
    for dev, _ in sata_disks():
        # the normal timer: none for the system disk, 20 minutes for a data-only HDD (as
        # mrg5-storage sets it at boot)
        run("hdparm", "-S", "0" if dev == root else IDLE_TIMER, dev)
    if os.path.exists(HDMI_STANDBY):
        write(HDMI_STANDBY, "0")
    run("xset", "dpms", "force", "on", env=X_ENV)
    run("xset", "-dpms", env=X_ENV)           # as the launcher session sets it
    if os.path.exists(MICROP):
        run(MICROP, "set", "middle", "red", "off", "middle", "yellow", "off", "middle", "green", "on")
    try:
        os.unlink(STATE)
    except FileNotFoundError:
        pass
    log("standby off, SoC", temperature())


def wait_for_key():
    """Until a key or button press on any input device (new devices are picked up).
    Returns (grabbed fds, the fd and code of the key), or None if woken otherwise."""
    time.sleep(1.0)                            # let the Power key's own release pass
    fds = {}
    while os.path.exists(STATE):
        for path in glob.glob("/dev/input/event*"):
            if path not in fds.values():
                try:
                    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                except OSError:
                    continue
                try:
                    fcntl.ioctl(fd, EVIOCGRAB, 1)     # only we see its keys now
                except OSError:
                    pass
                fds[fd] = path
        ready, _, _ = select.select(list(fds), [], [], 2.0)
        for fd in ready:
            try:
                data = os.read(fd, EV.size * 64)
            except OSError:                    # the device went away (remote asleep)
                os.close(fd)
                del fds[fd]
                continue
            for i in range(0, len(data) - EV.size + 1, EV.size):
                _, _, typ, _code, val = EV.unpack_from(data, i)
                if typ == EV_KEY and val == 1:
                    return fds, fd, _code
    for f in fds:
        os.close(f)
    return None                                # woken by something else (mrg5-standby off)


def release(fds, fd, code):
    """Keep the grab until the waking key is let go (1.5 s at most), so neither the key
    nor its auto-repeat reaches a program; then let go of every device."""
    end = time.monotonic() + 1.5
    while time.monotonic() < end:
        if not select.select([fd], [], [], 0.1)[0]:
            continue
        try:
            data = os.read(fd, EV.size * 64)
        except OSError:
            break
        if any(EV.unpack_from(data, i)[2:5] == (EV_KEY, code, 0)
               for i in range(0, len(data) - EV.size + 1, EV.size)):
            break
    for f in fds:
        os.close(f)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "status":
        print("on" if os.path.exists(STATE) else "off")
        return
    if cmd not in ("on", "off", "toggle"):
        sys.exit(__doc__)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        active = os.path.exists(STATE)
        if cmd == "toggle":
            cmd = "off" if active else "on"
        if cmd == "off":
            if active:
                standby_off()
            return
        if active:
            return
        standby_on()
    woken = wait_for_key()
    if woken:
        with open(LOCK, "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if os.path.exists(STATE):
                standby_off()
        release(*woken)


if __name__ == "__main__":
    main()
